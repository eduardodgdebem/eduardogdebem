---
// A page corner that turns the page. Resting, it's a hint of a dog-ear; under
// the cursor (or focus) the corner lifts and folds back, showing the page
// beneath and the name of the page it turns to. Clicking navigates, and the
// view transition in codex.css turns the leaf from there.
import type { Turn } from '../layouts/Codex.astro';

interface Props {
  turn: Turn;
  rel: 'prev' | 'next';
  /** The copy shown only on portrait screens, where the spread is one column. */
  portrait?: boolean;
}

const { turn, rel, portrait = false } = Astro.props;
---

<a
  href={turn.href}
  rel={rel}
  class:list={['corner', `corner--${rel}`, { 'corner--portrait': portrait }]}
  aria-label={`${rel === 'prev' ? 'Previous' : 'Next'} page: ${turn.label}`}
>
  <span class="fold" aria-hidden="true"></span>
  <span class="corner-label" aria-hidden="true">{turn.label}</span>
</a>
