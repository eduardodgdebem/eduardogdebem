---
// An engraved plate (src/scripts/codex/engraving.ts) with a lettered banderole.
// The home page drives its own cycling plate; inner pages show one scene each.
import { CATALOGUE } from '../scripts/codex/catalogue';
import type { PlateId } from '../scripts/codex/models';

interface Props {
  plate: PlateId;
  /** Lettered on the banderole. */
  banner: string;
}

const { plate, banner } = Astro.props;
const { numeral, latin, note } = CATALOGUE[plate];
---

<figure class="plate">
  <div class="plate-frame">
    <canvas class="plate-canvas" data-engraving data-plate={plate} data-banner={banner} aria-hidden="true"></canvas>
    <div class="plate-fallback" aria-hidden="true"><span>{banner}</span></div>
  </div>
  <figcaption class="plate-caption">
    <span class="tab">Tab. {numeral}</span>
    <span class="cap-latin">{latin}</span>
    <span class="cap-note">{note}</span>
  </figcaption>
</figure>

<script>
  import { createEngraving } from '../scripts/codex/engraving';
  import type { PlateId } from '../scripts/codex/models';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  await document.fonts.load('150px "IM Fell English SC"').catch(() => undefined);

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-engraving]')) {
    const plate = createEngraving(canvas, {
      name: canvas.dataset.banner!,
      plates: [canvas.dataset.plate as PlateId],
      reducedMotion: reduced,
      onContextLost: () => document.documentElement.classList.add('no-webgl'),
    });
    if (!plate) document.documentElement.classList.add('no-webgl');
    plate?.intro();
    // Kept alive when the page goes into the back/forward cache.
    window.addEventListener('pagehide', (e) => !e.persisted && plate?.dispose());
  }
</script>
