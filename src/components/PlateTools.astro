---
// The plate's own controls, in its corner: zoom in and out (the scene listens
// for `plate:zoom` on its canvas; see src/scripts/codex/zoom.ts), and full
// screen, which spreads the plate over the whole window.
import { ICONS } from './icons';
import { tr, type Lang } from '../i18n/strings';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const s = tr(lang);
---

<div class="plate-tools" data-plate-tools data-full-label={s('tools.full')} data-exit-label={s('tools.exit')}>
  <button type="button" data-zoom="1.25" aria-label={s('tools.in')} title={s('tools.in')} set:html={ICONS.plus} />
  <button type="button" data-zoom="0.8" aria-label={s('tools.out')} title={s('tools.out')} set:html={ICONS.minus} />
  <button type="button" data-full aria-label={s('tools.full')} title={s('tools.full')} set:html={ICONS.expand} />
</div>

<script>
  import { ICONS } from './icons';

  for (const tools of document.querySelectorAll<HTMLElement>('[data-plate-tools]')) {
    const frame = tools.closest<HTMLElement>('.plate-frame')!;
    const canvas = frame.querySelector('canvas')!;
    for (const b of tools.querySelectorAll<HTMLButtonElement>('[data-zoom]')) {
      b.addEventListener('click', () => canvas.dispatchEvent(new CustomEvent('plate:zoom', { detail: Number(b.dataset.zoom) })));
    }
    // Spread out: the plate takes the whole open book, over both pages (on a
    // phone, where the book is one column, the screen).
    const full = tools.querySelector<HTMLButtonElement>('[data-full]')!;
    const root = document.documentElement;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let fading: Animation | null = null;
    // Spread or put back, the plate isn't stretched to its new size: it fades
    // to bare paper, is laid there, and is engraved afresh (the scene listens
    // for `plate:redraw`), its banderole unrolling again.
    const lay = (on: boolean) => {
      frame.classList.toggle('is-full', on);
      root.classList.toggle('plate-is-full', on);
      requestAnimationFrame(() => window.dispatchEvent(new Event('resize')));
    };
    let spread = false;
    const setFull = (on: boolean) => {
      // A second press while it's changing waits for this one.
      if (fading) return;
      spread = on;
      if (still) {
        lay(on);
      } else {
        const out = frame.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 160, easing: 'ease-in', fill: 'forwards' });
        fading = out;
        out.onfinish = () => {
          lay(on);
          canvas.dispatchEvent(new CustomEvent('plate:redraw'));
          const back = frame.animate(
            [
              { opacity: 0, transform: 'scale(0.985)' },
              { opacity: 1, transform: 'none' },
            ],
            { duration: 420, easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)' },
          );
          out.cancel();
          fading = back;
          back.onfinish = () => (fading = null);
        };
      }
      full.innerHTML = on ? ICONS.shrink : ICONS.expand;
      const label = on ? tools.dataset.exitLabel! : tools.dataset.fullLabel!;
      full.setAttribute('aria-label', label);
      full.title = label;
    };
    full.addEventListener('click', () => setFull(!spread));
    document.addEventListener('keydown', (e) => e.key === 'Escape' && spread && setFull(false));
  }
</script>
