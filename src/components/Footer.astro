---
const year = new Date().getFullYear();
---

<footer class="relative z-10 bg-void border-t border-trench px-8 md:px-14 py-8">
  <div class="flex items-center justify-between flex-wrap gap-4">
    <span class="font-mono text-xs text-brush tracking-widest">
      © {year} EDUARDO DE BEM
    </span>
    <div class="flex items-center gap-6">
      <a
        href="https://github.com/eduardodgdebem"
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-xs text-brush hover:text-signal tracking-widest transition-colors duration-200"
      >
        GITHUB
      </a>
      <a
        href="/rss.xml"
        class="font-mono text-xs text-brush hover:text-signal tracking-widest transition-colors duration-200"
      >
        RSS
      </a>
    </div>
  </div>
</footer>
