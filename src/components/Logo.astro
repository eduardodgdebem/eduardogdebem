---
import { SIGIL, SIGIL_BOX } from './sigil';

interface Props {
  size?: number;
  class?: string;
}
const { size = 40, class: className } = Astro.props;
---

<svg width={size} height={size} viewBox={`0 0 ${SIGIL_BOX} ${SIGIL_BOX}`} fill="currentColor" xmlns="http://www.w3.org/2000/svg" style="fill-rule:evenodd;clip-rule:evenodd;" class={className}>
  <path d={SIGIL} />
</svg>
