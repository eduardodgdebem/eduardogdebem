---
// A historiated initial, as old books open a text: the letter in rubric on a
// ground of close-ruled hatching, vines curling round it in the paper's white,
// all in a ruled square. Drawn as one SVG at build; the page animates its parts
// (.wc-ground, .wc-vine, .wc-letter) in on arrival.

interface Props {
  letter: string;
  class?: string;
}

const { letter, class: className } = Astro.props;

type Pt = [number, number];

/** A wavy stem from a to b, swaying `amp` either side `waves` times. */
const stem = (a: Pt, b: Pt, amp: number, waves: number): Pt[] => {
  const [dx, dy] = [b[0] - a[0], b[1] - a[1]];
  const len = Math.hypot(dx, dy);
  const [nx, ny] = [-dy / len, dx / len];
  return Array.from({ length: 41 }, (_, i) => {
    const t = i / 40;
    const w = amp * Math.sin(t * Math.PI * 2 * waves) * Math.sin(t * Math.PI);
    return [a[0] + dx * t + nx * w, a[1] + dy * t + ny * w] as Pt;
  });
};

/** Carry on from p into a spiral round c, winding `dir` (1 clockwise on screen). */
const spiral = (p: Pt, c: Pt, turns: number, dir: 1 | -1): Pt[] => {
  const a0 = Math.atan2(p[1] - c[1], p[0] - c[0]);
  const r = Math.hypot(p[0] - c[0], p[1] - c[1]);
  return Array.from({ length: 49 }, (_, i) => {
    const t = (i / 48) * turns;
    const rr = r * (1 - t / (turns * 1.2));
    const a = a0 + dir * t * Math.PI * 2;
    return [c[0] + rr * Math.cos(a), c[1] + rr * Math.sin(a)] as Pt;
  });
};

const path = (pts: Pt[]) => 'M' + pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join('L');

/** A leaf: a pointed oval springing from (x, y), turned to `deg`. */
const leaf = ([x, y]: Pt, deg: number, len = 10) =>
  `<path transform="translate(${x.toFixed(1)} ${y.toFixed(1)}) rotate(${deg.toFixed(0)})" d="M0,0 C${len * 0.3},${-len * 0.34} ${len * 0.75},${-len * 0.32} ${len},0 C${len * 0.75},${len * 0.32} ${len * 0.3},${len * 0.34} 0,0Z"/>`;

/** Leaves along a stem, alternately either side of it. */
const leaves = (pts: Pt[], at: number[]) =>
  at
    .map((i, k) => {
      const [p, q] = [pts[i], pts[i + 1]];
      const along = (Math.atan2(q[1] - p[1], q[0] - p[0]) * 180) / Math.PI;
      return leaf(p, along + (k % 2 ? 55 : -55));
    })
    .join('');

// Two vines climb the sides of the square, the left one up to curl in the
// top-left corner, the right one down to curl in the bottom-right; a tendril
// curls in each of the other two corners.
const left = stem([12, 91], [14, 30], 2.6, 2);
const right = stem([88, 9], [86, 70], 2.6, 2);
const VINES = [
  path([...left, ...spiral(left[40], [22, 21], 1.5, 1)]),
  path([...right, ...spiral(right[40], [78, 79], 1.5, 1)]),
  path([[92, 30], ...spiral([86, 18], [80, 20], 1.4, -1)]),
  path([[8, 70], ...spiral([14, 82], [20, 80], 1.4, -1)]),
];
const LEAVES = leaves(left, [6, 15, 24, 33]) + leaves(right, [6, 15, 24, 33]);
---

<span class:list={['woodcut', className]} aria-hidden="true">
  <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id="wc-hatch" width="2.4" height="2.4" patternUnits="userSpaceOnUse">
        <path style="stroke:var(--ink)" d="M0,1.2H2.4" stroke-width="1.15" />
      </pattern>
      <clipPath id="wc-inside"><rect x="7" y="7" width="86" height="86" /></clipPath>
    </defs>
    <rect class="wc-ground" x="7" y="7" width="86" height="86" fill="url(#wc-hatch)" />
    <g clip-path="url(#wc-inside)" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <!-- Each vine twice: a dark edge, then the paper-white stem inside it, as a woodcut leaves it. -->
      {VINES.map((d) => <path style="stroke:var(--ink)" class="wc-vine" d={d} stroke-width="4" pathLength="1" />)}
      {VINES.map((d) => <path style="stroke:var(--paper)" class="wc-vine" d={d} stroke-width="2.1" pathLength="1" />)}
      <g style="fill:var(--paper);stroke:var(--ink)" class="wc-leaves" stroke-width="1" set:html={LEAVES} />
    </g>
    <rect style="stroke:var(--ink)" x="2" y="2" width="96" height="96" fill="none" stroke-width="2.6" />
    <rect style="stroke:var(--ink)" x="7" y="7" width="86" height="86" fill="none" stroke-width="1" />
    <g class="wc-letter">
      <text style="fill:var(--paper);stroke:var(--paper)" x="51" y="77" text-anchor="middle" font-size="74" stroke-width="6" stroke-linejoin="round">{letter}</text>
      <text style="fill:var(--rubric);stroke:var(--ink)" x="51" y="77" text-anchor="middle" font-size="74" stroke-width="0.9">{letter}</text>
    </g>
  </svg>
</span>

<style>
  .woodcut {
    display: inline-block;
    flex: none;
  }

  .woodcut svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .woodcut text {
    font-family: 'IM Fell English', serif;
  }
</style>
