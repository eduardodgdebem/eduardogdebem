---
// The front board of the codex. On the first page of a visit the book arrives
// closed: the gilt sigil is tooled into the leather while the page loads, then
// the board swings open on the spine (src/scripts/codex/opening.ts). Shown only
// when the inline script in Codex.astro sets `html.opening`.
import { SIGIL, SIGIL_BOX } from './sigil';
---

<div class="binding" aria-hidden="true">
  <div class="board">
    <div class="board-front">
      <div class="tooling">
        <p class="board-title">Codex</p>
        <svg class="board-sigil" viewBox={`0 0 ${SIGIL_BOX} ${SIGIL_BOX}`}>
          <path d={SIGIL} pathLength="1" />
        </svg>
        <p class="board-title">Edvardi</p>
        <p class="board-year">MMXXVI</p>
      </div>
    </div>
    <div class="board-back"></div>
  </div>
</div>
