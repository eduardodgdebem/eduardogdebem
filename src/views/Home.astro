---
// The index spread, in English (/) or Portuguese (/pt/).
import Codex from '../layouts/Codex.astro';
import PlateTools from '../components/PlateTools.astro';
import { CV_PDF, SHOW_NOW_PLAYING, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { ICONS } from '../components/icons';
import { tr, type Lang } from '../i18n/strings';
import { PATHS, href } from '../i18n/paths';
import { PERSON, WEBSITE } from '../seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = tr(lang);
const META = {
  en: { title: `${SITE_TITLE} — Full Stack Developer in Florianópolis`, description: SITE_DESCRIPTION },
  pt: {
    title: `${SITE_TITLE} — Desenvolvedor Full Stack em Florianópolis`,
    description:
      'Eduardo de Bem, desenvolvedor full stack em Florianópolis. TypeScript, Angular, React, Node.js e .NET; pipelines de dados para a BMW Europa na Zallpy.',
  },
}[lang];

// The places in the forum on the left page, each standing for a page. Their
// notes are in src/i18n/strings.ts, under place.<id>.
// The terminal on the hero: real commands, one a tab.
const SITE = Astro.site!.origin;
const COMMANDS = [
  { tab: 'cv', cmd: `curl -O ${SITE}${CV_PDF}` },
  { tab: 'rss', cmd: `curl ${SITE}/rss.xml` },
  { tab: 'git', cmd: 'git clone https://github.com/eduardodgdebem/eduardogdebem' },
];

// The rays over the forum: lines out from one point in its sky, as a diagram's.
const RAYS = Array.from({ length: 36 }, (_, i) => {
  const a = (i / 36) * Math.PI * 2 + 0.05;
  const r = i % 3 ? 900 : 1400;
  return `M${(720 + Math.cos(a) * 46).toFixed(1)},${(170 + Math.sin(a) * 46).toFixed(1)}L${(720 + Math.cos(a) * r).toFixed(1)},${(170 + Math.sin(a) * r).toFixed(1)}`;
}).join('');

const PLACES = { forum: 'Via Sacra', bibliotheca: 'Bibliotheca', fabrica: 'Fabrica', statua: 'Statua', amphitheatrum: 'Amphitheatrum' };
---

<Codex
  lang={lang}
  alternates={PATHS.home}
  title={META.title}
  description={META.description}
  at="home"
  fit
  schema={{ '@context': 'https://schema.org', '@graph': [WEBSITE, PERSON] }}
>
  <!-- Verso: the forum, engraved, under its banderole -->
  <Fragment slot="verso">
    <figure class="plate">
      <div class="plate-frame">
        <canvas id="engraving" class="plate-canvas" aria-hidden="true"></canvas>
        <div class="plate-fallback" aria-hidden="true"><span>Forum</span></div>
        <!-- Ray lines and registration over the forum: an engraving read as a diagram. -->
        <svg class="rays" viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <g class="rays-burst"><path d={RAYS} pathLength="1" /></g>
          <circle class="rays-ring" cx="720" cy="170" r="46" pathLength="1" />
          <circle class="rays-ring" cx="720" cy="170" r="118" pathLength="1" />
          <path class="rays-axis" d="M0,170H1000M720,0V1000" pathLength="1" />
        </svg>
        <p class="plate-coords" aria-hidden="true"><span>41°53′32″N</span><span>12°29′07″E</span></p>
        <!-- The label over a building in the forum: what it is, and where it leads. -->
        <div class="place-tag" data-tag aria-hidden="true">
          <span class="tag-latin" data-tag-latin></span>
          <span class="tag-page" data-tag-page></span>
          <span class="tag-by" data-tag-by></span>
          <span class="tag-act" data-tag-act></span>
        </div>
        <PlateTools lang={lang} info="home" />
      </div>
      <figcaption class="plate-caption" data-places={JSON.stringify(PLACES)}>
        <span class="tab">Tab. I</span>
        <span class="cap-latin" data-cap-latin>{PLACES.forum}</span>
        <span class="cap-note" data-cap-note>{s('place.forum')}</span>
      </figcaption>
    </figure>

  </Fragment>

  <!-- Recto: who this is and how to reach him, the index, and what he is listening to -->
  <Fragment slot="recto">
    <!-- The hero: one large plain sentence, small tracked labels, two actions and a terminal. -->
    <header class="hero">
      <p class="eyebrow"><span class="eyebrow-mark" aria-hidden="true"></span><span data-i18n="home.role">{s('home.role')}</span></p>
      <h1 class="headline"><span class="sr-only">Eduardo de Bem: </span><span data-i18n="home.headline">{s('home.headline')}</span></h1>
      <p class="lede" data-i18n="home.lede">{s('home.lede')}</p>
      <p class="actions">
        <a class="btn btn--primary" href={href(lang, 'projects')} data-place="fabrica"><Fragment set:html={ICONS.arrow} /><span data-i18n="home.cta.work">{s('home.cta.work')}</span></a>
        <a class="btn" href={CV_PDF} download><Fragment set:html={ICONS.download} /><span data-i18n="home.cta.cv">{s('home.cta.cv')}</span></a>
      </p>
      <div class="term" data-term>
        <div class="term-tabs" role="tablist" aria-label="Commands">
          {COMMANDS.map((c, i) => (
            <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-cmd={c.cmd}>{c.tab}</button>
          ))}
        </div>
        <div class="term-line">
          <span class="term-prompt" aria-hidden="true">$</span>
          <code data-term-cmd>{COMMANDS[0].cmd}</code>
          <button type="button" class="term-copy" data-term-copy aria-label={s('term.copy')} data-copied={s('term.copied')}><Fragment set:html={ICONS.copy} /></button>
        </div>
      </div>
    </header>

    <nav class="contents" aria-label="Contents">
      <p class="rubric">Index</p>
      <ol>
        <li class="chapter">
          <a href={href(lang, 'notes')} data-place="bibliotheca"><span class="num">01</span><span class="label" data-i18n="home.index.notes">{s('home.index.notes')}</span><span class="leader"><i></i></span><span class="pg" data-i18n="home.index.notes.pg">{s('home.index.notes.pg')}</span></a>
        </li>
        <li class="chapter">
          <a href={href(lang, 'about')} data-place="statua"><span class="num">02</span><span class="label" data-i18n="home.index.author">{s('home.index.author')}</span><span class="leader"><i></i></span><span class="pg" data-i18n="home.index.author.pg">{s('home.index.author.pg')}</span></a>
        </li>
        <li class="chapter">
          <a href={href(lang, 'projects')} data-place="fabrica"><span class="num">03</span><span class="label" data-i18n="home.index.workshop">{s('home.index.workshop')}</span><span class="leader"><i></i></span><span class="pg" data-i18n="home.index.workshop.pg">{s('home.index.workshop.pg')}</span></a>
        </li>
        <li class="chapter">
          <a href={href(lang, 'ludus')} data-place="amphitheatrum"><span class="num">04</span><span class="label" data-i18n="home.index.ludus">{s('home.index.ludus')}</span><span class="leader"><i></i></span><span class="pg" data-i18n="home.index.ludus.pg">{s('home.index.ludus.pg')}</span></a>
        </li>
        <li class="chapter">
          <a href={`${href(lang, 'about')}#correspondence`}><span class="num">05</span><span class="label" data-i18n="home.index.letters">{s('home.index.letters')}</span><span class="leader"><i></i></span><span class="pg" data-i18n="home.index.letters.pg">{s('home.index.letters.pg')}</span></a>
        </li>
      </ol>
    </nav>

    <!-- Jellyfin: the cover, re-drawn as an engraving; hidden if it can't be reached. Off for now (SHOW_NOW_PLAYING). -->
    {SHOW_NOW_PLAYING && (
    <aside class="listening" data-media hidden aria-label="What I'm listening to and watching">
      <figure class="cover" data-cover hidden>
        <canvas id="cover" aria-hidden="true"></canvas>
      </figure>
      <div class="listening-text">
        <p data-slot="listening" hidden>
          <span class="hand" aria-hidden="true">☞</span> <em data-verb></em><br />
          <span class="track" data-title></span><br /><span class="by" data-sub></span>
        </p>
        <p class="watching" data-slot="watching" hidden>
          <em data-verb></em> <span data-title></span><span class="by" data-sub></span>
        </p>
      </div>
    </aside>
    )}
  </Fragment>
</Codex>

<script>
  import { gsap } from 'gsap';
  import { createCoverEngraving } from '../scripts/codex/cover';
  import { createForum, type Place } from '../scripts/codex/forum';
  import { SPEECHES } from '../scripts/codex/orator';
  import { pick, t } from '../scripts/codex/lang';
  import { inView } from '../scripts/codex/visible';
  import { bookOpened } from '../scripts/codex/opening';
  import { ICONS } from '../components/icons';

  const root = document.documentElement;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // No hover, no keyboard: labels are tapped instead of Enter pressed.
  const touch = matchMedia('(hover: none)').matches;
  const canvas = document.getElementById('engraving') as HTMLCanvasElement;

  // The banderole and the inscriptions letter with the page fonts, so wait for them.
  await Promise.all([document.fonts.load('300 150px "Barlow Condensed"'), document.fonts.load('600 80px Cinzel')]).catch(() => undefined);

  /* ── The forum: hover a place (here or in the index) to pick it out; go to it to turn the page ── */

  const caption = document.querySelector<HTMLElement>('.plate-caption')!;
  const PLACES: Record<Place | 'forum', string> = JSON.parse(caption.dataset.places!);
  const tag = document.querySelector<HTMLElement>('[data-tag]')!;
  const tagLatin = tag.querySelector<HTMLElement>('[data-tag-latin]')!;
  const tagPage = tag.querySelector<HTMLElement>('[data-tag-page]')!;
  const tagBy = tag.querySelector<HTMLElement>('[data-tag-by]')!;
  const tagAct = tag.querySelector<HTMLElement>('[data-tag-act]')!;
  // On touch screens the label at a door is the way in.
  let tagged: Place | 'orator' | null = null;
  tag.addEventListener('click', () => tagged && tagged !== 'orator' && chapterFor(tagged)?.click());

  // The orator: a new speech each time the citizen comes within earshot, and
  // another every little while he stays to listen.
  let speech = Math.floor(Math.random() * SPEECHES.length);
  let listening = false;
  let nextSpeech: ReturnType<typeof setTimeout> | undefined;
  const say = () => {
    const { text, by } = pick(SPEECHES[speech], SPEECHES[speech].pt);
    tagPage.textContent = `“${text}”`;
    tagBy.textContent = `— ${by}`;
  };
  const speak = () => {
    speech = (speech + 1) % SPEECHES.length;
    say();
    clearTimeout(nextSpeech);
    nextSpeech = setTimeout(speak, 8000);
  };
  const cap = {
    latin: caption.querySelector<HTMLElement>('[data-cap-latin]')!,
    note: caption.querySelector<HTMLElement>('[data-cap-note]')!,
  };
  const links = [...document.querySelectorAll<HTMLAnchorElement>('a[data-place]')];
  // The index's chapter line for each place, lit when its building is hovered in the scene.
  const chapterFor = (place: Place | null) => links.find((a) => a.dataset.place === place && !a.closest('.sub'));

  const describe = (place: Place | null, atDoor = false) => {
    const note = t(`place.${place ?? 'forum'}`);
    cap.latin.textContent = PLACES[place ?? 'forum'];
    cap.note.textContent = atDoor ? `${note} ${t(touch ? 'home.door.touch' : 'home.door.key')}` : note;
  };

  const forum = createForum(canvas, {
    name: 'Forum',
    reducedMotion: reduced,
    onContextLost: () => root.classList.add('no-webgl'),
    onFocus: (place, atDoor) => {
      describe(place, atDoor);
      links.forEach((a) => a.classList.toggle('is-lit', a === chapterFor(place)));
    },
    onEnter: (place) => chapterFor(place)?.click(),
    onTag: (subject, x, y) => showTag(subject, x, y),
  });
  if (!forum) root.classList.add('no-webgl');
  forum?.intro(bookOpened());

  function showTag(subject: Place | 'orator' | null, x: number, y: number) {
    tag.classList.toggle('is-shown', !!subject);
    tagged = subject;
    tag.classList.toggle('is-actionable', !!subject && subject !== 'orator');
    tagAct.textContent = subject && subject !== 'orator' ? t('home.act') : '';
    const orator = subject === 'orator';
    tag.classList.toggle('is-speech', orator);
    if (orator !== listening) {
      listening = orator;
      if (orator) speak();
      else clearTimeout(nextSpeech);
    }
    if (!subject) return;
    if (!orator) {
      tagLatin.textContent = PLACES[subject];
      tagPage.textContent = t(`place.${subject}.page`);
      tagBy.textContent = '';
    } else {
      tagLatin.textContent = 'Orator';
    }
    // Kept inside the plate; it flips below its building near the top edge.
    const w = tag.offsetWidth;
    const frame = tag.parentElement!.clientWidth;
    tag.style.left = `${Math.min(Math.max(x, w / 2 + 6), frame - w / 2 - 6)}px`;
    tag.style.top = `${y}px`;
    tag.classList.toggle('is-below', y < tag.offsetHeight + 70);
  }


  // Once he's on his way to a door, more taps change nothing.
  let going = false;
  for (const a of links) {
    const place = a.dataset.place as Place;
    // Only a mouse's hover, or the keyboard's focus, lights the building. On a
    // touch screen a hover that changes the page makes iOS Safari take the
    // first tap as the hover, and the link isn't followed.
    const on = (e: Event) => {
      if (e instanceof PointerEvent ? e.pointerType === 'mouse' : a.matches(':focus-visible')) forum?.highlight(place);
    };
    const off = () => forum?.highlight(null);
    a.addEventListener('pointerenter', on);
    a.addEventListener('focus', on);
    a.addEventListener('pointerleave', off);
    a.addEventListener('blur', off);
    a.addEventListener('click', (e) => {
      if (!forum || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      if (going) return e.preventDefault();
      // Nobody to watch him walk there (scrolled away, on a phone): just turn the page.
      if (!inView(canvas)) return;
      // Off-site (the workshop): the new tab must open from the click itself,
      // so the citizen walks over while it does, then comes back.
      if (a.target === '_blank') {
        forum.walk(place).then(() => setTimeout(() => forum.reset(), 600));
        return;
      }
      e.preventDefault();
      going = true;
      forum.walk(place).then(() => location.assign(a.href));
    });
  }

  // Back from the next page through the back/forward cache: the citizen is home again.
  window.addEventListener('pageshow', (e) => {
    if (!e.persisted) return;
    going = false;
    forum?.reset();
  });

  /* ── Jellyfin: cover engraving and marginal note ── */

  type Entry = { title: string; subtitle: string; image: string | null; live: boolean; paused: boolean } | null;
  // Only when the note is on the page (SHOW_NOW_PLAYING).
  const media = document.querySelector<HTMLElement>('[data-media]');
  const coverFig = document.querySelector<HTMLElement>('[data-cover]');
  const cover = media && createCoverEngraving(document.getElementById('cover') as HTMLCanvasElement, { reducedMotion: reduced });
  const VERBS = { listening: ['Nunc audit', 'Nuper audivit'], watching: ['Nunc spectat:', 'Nuper spectavit:'] } as const;

  const refresh = async () => {
    if (!media || !coverFig) return;
    try {
      const res = await fetch('/api/now-playing.json');
      if (!res.ok) throw new Error(String(res.status));
      const data = (await res.json()) as Record<'listening' | 'watching', Entry>;
      (['listening', 'watching'] as const).forEach((k) => {
        const el = media.querySelector<HTMLElement>(`[data-slot="${k}"]`)!;
        const e = data[k];
        el.hidden = !e;
        if (!e) return;
        el.querySelector('[data-verb]')!.textContent = VERBS[k][e.live && !e.paused ? 0 : 1];
        el.querySelector('[data-title]')!.textContent = e.title;
        el.querySelector('[data-sub]')!.textContent = k === 'watching' ? (e.subtitle ? `, ${e.subtitle}` : '') : e.subtitle;
      });
      media.hidden = !data.listening && !data.watching;
      // Engrave the record's cover; fall back to the watching poster.
      const art = data.listening?.image ?? data.watching?.image;
      coverFig.hidden = !art || !cover;
      if (art && cover) coverFig.hidden = !(await cover.set(art));
    } catch {
      media.hidden = true;
    }
  };
  if (media) {
    refresh();
    setInterval(() => !document.hidden && refresh(), 60_000);
  }

  /* ── Arrival (skipped when arriving by page turn: the leaf is the entrance) ── */

  const turned = !!(window as unknown as { navigation?: { activation?: { from?: unknown } } }).navigation?.activation?.from;
  if (!reduced && !turned) {
    // The hero rises in, line by line, and the rays are drawn out from the
    // forum's sky, slowly.
    gsap.from('.hero > *, .contents', { autoAlpha: 0, y: 12, duration: 1.1, stagger: 0.09, ease: 'power3.out', delay: 0.15 });
    gsap.fromTo('.rays path, .rays circle', { strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 2.6, stagger: 0.25, ease: 'power2.inOut', delay: 0.6 });
    gsap.from('.plate-caption, .plate-coords', { autoAlpha: 0, duration: 1.4, delay: 1.6 });
  }

  /* ── The terminal: a tab a command, and a button to copy it ── */

  const term = document.querySelector<HTMLElement>('[data-term]')!;
  const cmd = term.querySelector<HTMLElement>('[data-term-cmd]')!;
  const copy = term.querySelector<HTMLButtonElement>('[data-term-copy]')!;
  const tabs = [...term.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  for (const tab of tabs)
    tab.addEventListener('click', () => {
      tabs.forEach((b) => b.setAttribute('aria-selected', String(b === tab)));
      cmd.textContent = tab.dataset.cmd!;
      if (!reduced) gsap.from(cmd, { autoAlpha: 0, x: -6, duration: 0.35, ease: 'power2.out' });
    });
  const COPY_ICON = copy.innerHTML;
  copy.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(cmd.textContent ?? '');
    } catch {
      return;
    }
    copy.innerHTML = `${ICONS.check}<span class="term-copied">${copy.dataset.copied}</span>`;
    setTimeout(() => (copy.innerHTML = COPY_ICON), 1600);
  });

  // Kept alive when the page goes into the back/forward cache.
  window.addEventListener('pagehide', (e) => {
    if (e.persisted) return;
    forum?.dispose();
    cover?.dispose();
  });
</script>

<style>
  /* ── Verso ── */


  /* The street isn't dragged: the cursor is plain, a hand over a building. */
  #engraving,
  #engraving:active {
    cursor: default;
  }

  /* ── Verso: rays and coordinates over the forum ── */

  .rays {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    fill: none;
    stroke: var(--ink);
    stroke-width: 0.6;
    vector-effect: non-scaling-stroke;
    opacity: 0.16;
  }

  .rays :is(path, circle) {
    stroke-dasharray: 1;
    vector-effect: non-scaling-stroke;
  }

  .rays-burst {
    transform-origin: 720px 170px;
    animation: drift 240s linear infinite;
  }

  .rays-ring {
    stroke: var(--rubric);
    opacity: 0.9;
  }

  .rays-axis {
    stroke-dasharray: 0.004 0.006 !important;
    opacity: 0.7;
  }

  @keyframes drift {
    to {
      rotate: 360deg;
    }
  }

  .plate-coords {
    position: absolute;
    z-index: 1;
    left: 14px;
    bottom: 10px;
    display: flex;
    gap: 1.2em;
    margin: 0;
    font-family: var(--f-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .rays-burst {
      animation: none;
    }
  }

  /* ── Recto: the hero, then the index ── */

  .hero {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(8px, 3vh, 40px) 0;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0 0 clamp(14px, 3vh, 30px);
    font-family: var(--f-label);
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .eyebrow-mark {
    width: 28px;
    height: 1px;
    background: var(--rubric);
  }

  /* One huge, light, condensed sentence. */
  .headline {
    max-width: 9.5em;
    margin: 0;
    font-family: var(--f-display);
    font-weight: 200;
    font-size: clamp(3rem, min(7vw, 10.5vh), 8.2rem);
    line-height: 0.9;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .lede {
    max-width: 38ch;
    margin: clamp(16px, 3vh, 30px) 0 0;
    font-weight: 300;
    font-size: clamp(0.95rem, 0.3vw + 0.8rem, 1.08rem);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  /* Flat, sharp buttons, told apart by tone, not colour. */
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: clamp(18px, 3.4vh, 34px) 0 0;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.85rem 1.2rem;
    font-family: var(--f-label);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    background: var(--surface);
    transition: background-color 0.3s ease;
  }

  .btn--primary {
    background: var(--surface-2);
  }

  .btn :global(svg) {
    font-size: 14px;
    color: var(--ink-soft);
  }

  .btn:hover,
  .btn.is-lit {
    color: var(--ink);
    background: #26323a;
  }

  /* The terminal: the loudest thing on the page, a solid block of the accent. */
  .term {
    width: min(100%, 34rem);
    margin: clamp(18px, 3.4vh, 34px) 0 0;
    background: var(--rubric);
    color: var(--on-accent);
    font-family: var(--f-mono);
  }

  .term-tabs {
    display: flex;
    gap: 1.2rem;
    padding: 0.7rem 1rem 0;
  }

  .term-tabs button {
    padding: 0 0 0.15rem;
    font: inherit;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: inherit;
    background: none;
    border: 0;
    border-bottom: 1px solid currentColor;
    opacity: 0.7;
    cursor: pointer;
  }

  .term-tabs button[aria-selected="true"] {
    font-weight: 500;
    border-bottom-color: transparent;
    opacity: 1;
  }

  .term-tabs button:hover {
    opacity: 1;
  }

  .term-line {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.75rem 0.6rem 0.85rem 1rem;
    font-size: clamp(0.7rem, 0.25vw + 0.6rem, 0.8rem);
  }

  .term-prompt {
    opacity: 0.55;
  }

  .term-line code {
    padding: 0;
    color: inherit;
