---
// The index spread, in English (/) or Portuguese (/pt/).
import { getCollection } from 'astro:content';
import Codex from '../layouts/Codex.astro';
import { CV_PDF, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { tr, type Lang } from '../i18n/strings';
import { PATHS, href } from '../i18n/paths';
import { PERSON, WEBSITE } from '../seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = tr(lang);
const META = {
  en: { title: `${SITE_TITLE} — Full Stack Developer in Florianópolis`, description: SITE_DESCRIPTION },
  pt: {
    title: `${SITE_TITLE} — Desenvolvedor Full Stack em Florianópolis`,
    description:
      'Eduardo de Bem, desenvolvedor full stack em Florianópolis. TypeScript, Angular, React, Node.js e .NET; pipelines de dados para a BMW Europa na Zallpy.',
  },
}[lang];

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const roman = (n: number) =>
  ([['M', 1000], ['CM', 900], ['D', 500], ['CD', 400], ['C', 100], ['XC', 90], ['L', 50], ['XL', 40], ['X', 10], ['IX', 9], ['V', 5], ['IV', 4], ['I', 1]] as const).reduce(
    (acc, [s, v]) => {
      while (acc.n >= v) {
        acc.out += s;
        acc.n -= v;
      }
      return acc;
    },
    { n, out: '' },
  ).out;

// The places in the forum on the left page, each standing for a page. Their
// notes are in src/i18n/strings.ts, under place.<id>.
const PLACES = { forum: 'Via Sacra', bibliotheca: 'Bibliotheca', fabrica: 'Fabrica', statua: 'Statua' };
---

<Codex
  lang={lang}
  alternates={PATHS.home}
  title={META.title}
  description={META.description}
  folio={1}
  fit
  schema={{ '@context': 'https://schema.org', '@graph': [WEBSITE, PERSON] }}
>
  <!-- Verso: the forum, engraved, under its banderole -->
  <Fragment slot="verso">
    <figure class="plate">
      <div class="plate-frame">
        <canvas id="engraving" class="plate-canvas" aria-hidden="true"></canvas>
        <div class="plate-fallback" aria-hidden="true"><span>Forum</span></div>
        <!-- The label over a building in the forum: what it is, and where it leads. -->
        <div class="place-tag" data-tag aria-hidden="true">
          <span class="tag-latin" data-tag-latin></span>
          <span class="tag-page" data-tag-page></span>
          <span class="tag-by" data-tag-by></span>
          <span class="tag-act" data-tag-act></span>
        </div>
      </div>
      <figcaption class="plate-caption" data-places={JSON.stringify(PLACES)}>
        <span class="tab">Tab. I</span>
        <span class="cap-latin" data-cap-latin>{PLACES.forum}</span>
        <span class="cap-note" data-cap-note>{s('place.forum')}</span>
      </figcaption>
    </figure>

    <p class="plate-nav">
      <span class="hint" data-i18n-html="home.hint" set:html={s('home.hint')} />
    </p>
    <p class="touch-hint" data-i18n="home.touch">{s('home.touch')}</p>
  </Fragment>

  <!-- Recto: who this is and how to reach him, the index, and what he is listening to -->
  <Fragment slot="recto">
    <header class="author">
      <h1>Eduardo de Bem</h1>
      <p class="role" data-i18n="home.role">{s('home.role')}</p>
      <p class="links">
        <a href="mailto:eduardogdebem@gmail.com" data-i18n="link.email">{s('link.email')}</a>
        <a href="https://linkedin.com/in/eduardogdebem" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://github.com/eduardodgdebem" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={CV_PDF} download data-i18n="link.cv">{s('link.cv')}</a>
        <a href={`${href(lang, 'about')}#correspondence`} data-i18n="link.contact">{s('link.contact')}</a>
      </p>
    </header>

    <div class="bio">
      <p class="lede" data-i18n-html="home.lede" set:html={s('home.lede')} />
      <p class="more" data-i18n="home.more">{s('home.more')}</p>
    </div>

    <nav class="contents" aria-label="Contents">
      <p class="rubric">Index</p>
      <ol>
        <li class="chapter">
          <a href={href(lang, 'notes')} data-place="bibliotheca"><span class="num">I.</span><span class="label" data-i18n="home.index.notes">{s('home.index.notes')}</span><span class="leader"></span><span class="pg" data-i18n="home.index.notes.pg">{s('home.index.notes.pg')}</span></a>
          <ol class="sub">
            {posts.map((p) => (
              <li>
                <a href={`/blog/${p.id}/`} data-place="bibliotheca"><span class="label">{p.data.title}</span><span class="leader"></span><span class="pg">{roman(p.data.pubDate.getFullYear())}</span></a>
              </li>
            ))}
          </ol>
        </li>
        <li class="chapter">
          <a href={href(lang, 'about')} data-place="statua"><span class="num">II.</span><span class="label" data-i18n="home.index.author">{s('home.index.author')}</span><span class="leader"></span><span class="pg" data-i18n="home.index.author.pg">{s('home.index.author.pg')}</span></a>
        </li>
        <li class="chapter">
          <a href="https://github.com/eduardodgdebem" target="_blank" rel="noopener noreferrer" data-place="fabrica"><span class="num">III.</span><span class="label" data-i18n="home.index.workshop">{s('home.index.workshop')}</span><span class="leader"></span><span class="pg">github</span></a>
        </li>
        <li class="chapter">
          <a href={`${href(lang, 'about')}#correspondence`}><span class="num">IV.</span><span class="label" data-i18n="home.index.letters">{s('home.index.letters')}</span><span class="leader"></span><span class="pg" data-i18n="home.index.letters.pg">{s('home.index.letters.pg')}</span></a>
        </li>
      </ol>
    </nav>

    <!-- Jellyfin: the cover, re-drawn as an engraving; hidden if it can't be reached. -->
    <aside class="listening" data-media hidden aria-label="What I'm listening to and watching">
      <figure class="cover" data-cover hidden>
        <canvas id="cover" aria-hidden="true"></canvas>
      </figure>
      <div class="listening-text">
        <p data-slot="listening" hidden>
          <span class="hand" aria-hidden="true">☞</span> <em data-verb></em><br />
          <span class="track" data-title></span><br /><span class="by" data-sub></span>
        </p>
        <p class="watching" data-slot="watching" hidden>
          <em data-verb></em> <span data-title></span><span class="by" data-sub></span>
        </p>
      </div>
    </aside>
  </Fragment>
</Codex>

<script>
  import { gsap } from 'gsap';
  import { createCoverEngraving } from '../scripts/codex/cover';
  import { createForum, type Place } from '../scripts/codex/forum';
  import { SPEECHES } from '../scripts/codex/orator';
  import { pick, t } from '../scripts/codex/lang';
  import { inView } from '../scripts/codex/visible';
  import { bookOpened } from '../scripts/codex/opening';

  const root = document.documentElement;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // No hover, no keyboard: labels are tapped instead of Enter pressed.
  const touch = matchMedia('(hover: none)').matches;
  const canvas = document.getElementById('engraving') as HTMLCanvasElement;

  // The banderole and the inscriptions letter with the page fonts, so wait for them.
  await Promise.all([document.fonts.load('150px "IM Fell English SC"'), document.fonts.load('600 80px Cinzel')]).catch(() => undefined);

  /* ── The forum: hover a place (here or in the index) to pick it out; go to it to turn the page ── */

  const caption = document.querySelector<HTMLElement>('.plate-caption')!;
  const PLACES: Record<Place | 'forum', string> = JSON.parse(caption.dataset.places!);
  const tag = document.querySelector<HTMLElement>('[data-tag]')!;
  const tagLatin = tag.querySelector<HTMLElement>('[data-tag-latin]')!;
  const tagPage = tag.querySelector<HTMLElement>('[data-tag-page]')!;
  const tagBy = tag.querySelector<HTMLElement>('[data-tag-by]')!;
  const tagAct = tag.querySelector<HTMLElement>('[data-tag-act]')!;
  // On touch screens the label at a door is the way in.
  let tagged: Place | 'orator' | null = null;
  tag.addEventListener('click', () => tagged && tagged !== 'orator' && chapterFor(tagged)?.click());

  // The orator: a new speech each time the citizen comes within earshot, and
  // another every little while he stays to listen.
  let speech = Math.floor(Math.random() * SPEECHES.length);
  let listening = false;
  let nextSpeech: ReturnType<typeof setTimeout> | undefined;
  const say = () => {
    const { text, by } = pick(SPEECHES[speech], SPEECHES[speech].pt);
    tagPage.textContent = `“${text}”`;
    tagBy.textContent = `— ${by}`;
  };
  const speak = () => {
    speech = (speech + 1) % SPEECHES.length;
    say();
    clearTimeout(nextSpeech);
    nextSpeech = setTimeout(speak, 8000);
  };
  const cap = {
    latin: caption.querySelector<HTMLElement>('[data-cap-latin]')!,
    note: caption.querySelector<HTMLElement>('[data-cap-note]')!,
  };
  const links = [...document.querySelectorAll<HTMLAnchorElement>('a[data-place]')];
  // The index's chapter line for each place, lit when its building is hovered in the scene.
  const chapterFor = (place: Place | null) => links.find((a) => a.dataset.place === place && !a.closest('.sub'));

  const describe = (place: Place | null, atDoor = false) => {
    const note = t(`place.${place ?? 'forum'}`);
    cap.latin.textContent = PLACES[place ?? 'forum'];
    cap.note.textContent = atDoor ? `${note} ${t(touch ? 'home.door.touch' : 'home.door.key')}` : note;
  };

  const forum = createForum(canvas, {
    name: 'Forum',
    reducedMotion: reduced,
    onContextLost: () => root.classList.add('no-webgl'),
    onFocus: (place, atDoor) => {
      describe(place, atDoor);
      links.forEach((a) => a.classList.toggle('is-lit', a === chapterFor(place)));
    },
    onEnter: (place) => chapterFor(place)?.click(),
    onTag: (subject, x, y) => showTag(subject, x, y),
  });
  if (!forum) root.classList.add('no-webgl');
  forum?.intro(bookOpened());

  function showTag(subject: Place | 'orator' | null, x: number, y: number) {
    tag.classList.toggle('is-shown', !!subject);
    tagged = subject;
    tag.classList.toggle('is-actionable', !!subject && subject !== 'orator');
    tagAct.textContent = subject && subject !== 'orator' ? t('home.act') : '';
    const orator = subject === 'orator';
    tag.classList.toggle('is-speech', orator);
    if (orator !== listening) {
      listening = orator;
      if (orator) speak();
      else clearTimeout(nextSpeech);
    }
    if (!subject) return;
    if (!orator) {
      tagLatin.textContent = PLACES[subject];
      tagPage.textContent = t(`place.${subject}.page`);
      tagBy.textContent = '';
    } else {
      tagLatin.textContent = 'Orator';
    }
    // Kept inside the plate; it flips below its building near the top edge.
    const w = tag.offsetWidth;
    const frame = tag.parentElement!.clientWidth;
    tag.style.left = `${Math.min(Math.max(x, w / 2 + 6), frame - w / 2 - 6)}px`;
    tag.style.top = `${y}px`;
    tag.classList.toggle('is-below', y < tag.offsetHeight + 70);
  }


  for (const a of links) {
    const place = a.dataset.place as Place;
    const on = () => forum?.highlight(place);
    const off = () => forum?.highlight(null);
    a.addEventListener('pointerenter', on);
    a.addEventListener('focus', on);
    a.addEventListener('pointerleave', off);
    a.addEventListener('blur', off);
    a.addEventListener('click', (e) => {
      if (!forum || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      // Nobody to watch him walk there (scrolled away, on a phone): just turn the page.
      if (!inView(canvas)) return;
      // Off-site (the workshop): the new tab must open from the click itself,
      // so the citizen walks over while it does, then comes back.
      if (a.target === '_blank') {
        forum.walk(place).then(() => setTimeout(() => forum.reset(), 600));
        return;
      }
      e.preventDefault();
      forum.walk(place).then(() => location.assign(a.href));
    });
  }

  // Back from the next page through the back/forward cache: the citizen is home again.
  window.addEventListener('pageshow', (e) => e.persisted && forum?.reset());

  /* ── Jellyfin: cover engraving and marginal note ── */

  type Entry = { title: string; subtitle: string; image: string | null; live: boolean; paused: boolean } | null;
  const media = document.querySelector<HTMLElement>('[data-media]')!;
  const coverFig = document.querySelector<HTMLElement>('[data-cover]')!;
  const cover = createCoverEngraving(document.getElementById('cover') as HTMLCanvasElement, { reducedMotion: reduced });
  const VERBS = { listening: ['Nunc audit', 'Nuper audivit'], watching: ['Nunc spectat:', 'Nuper spectavit:'] } as const;

  const refresh = async () => {
    try {
      const res = await fetch('/api/now-playing.json');
      if (!res.ok) throw new Error(String(res.status));
      const data = (await res.json()) as Record<'listening' | 'watching', Entry>;
      (['listening', 'watching'] as const).forEach((k) => {
        const el = media.querySelector<HTMLElement>(`[data-slot="${k}"]`)!;
        const e = data[k];
        el.hidden = !e;
        if (!e) return;
        el.querySelector('[data-verb]')!.textContent = VERBS[k][e.live && !e.paused ? 0 : 1];
        el.querySelector('[data-title]')!.textContent = e.title;
        el.querySelector('[data-sub]')!.textContent = k === 'watching' ? (e.subtitle ? `, ${e.subtitle}` : '') : e.subtitle;
      });
      media.hidden = !data.listening && !data.watching;
      // Engrave the record's cover; fall back to the watching poster.
      const art = data.listening?.image ?? data.watching?.image;
      coverFig.hidden = !art || !cover;
      if (art && cover) coverFig.hidden = !(await cover.set(art));
    } catch {
      media.hidden = true;
    }
  };
  refresh();
  setInterval(() => !document.hidden && refresh(), 60_000);

  /* ── Arrival (skipped when arriving by page turn: the leaf is the entrance) ── */

  const turned = !!(window as unknown as { navigation?: { activation?: { from?: unknown } } }).navigation?.activation?.from;
  if (!reduced && !turned) {
    // Under a closed board the right page is already set; only the plate's
    // furniture waits for the book to open.
    const opening = root.classList.contains('opening');
    if (!opening) gsap.from('.recto .page-body > *', { autoAlpha: 0, y: 8, duration: 1.4, stagger: 0.12, ease: 'power2.out', delay: 0.6 });
    bookOpened().then(() => gsap.from('.plate-caption, .plate-nav', { autoAlpha: 0, duration: 1.4, delay: opening ? 1.2 : 2.4 }));
  }

  // Kept alive when the page goes into the back/forward cache.
  window.addEventListener('pagehide', (e) => {
    if (e.persisted) return;
    forum?.dispose();
    cover?.dispose();
  });
</script>

<style>
  /* ── Verso ── */


  .plate-nav {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0.5rem 12px 0;
  }

  /* The street isn't dragged: the cursor is plain, a hand over a building. */
  #engraving,
  #engraving:active {
    cursor: default;
  }

  .hint kbd {
    font-family: inherit;
    font-style: normal;
    font-size: 0.8em;
    padding: 0 0.3em;
    margin: 0 0.1em;
    border: 1px solid var(--rule);
    border-radius: 2px;
  }

  .hint {
    margin-left: auto;
    font-style: italic;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  /* ── Recto ── */

  .author {
    flex: none;
    margin: clamp(2px, 1.1vh, 16px) 0 0;
  }

  .author h1 {
    font-size: clamp(1.9rem, 2.9vw, 2.9rem);
    line-height: 1;
    margin: 0;
  }

  .role {
    margin: 0.25rem 0 0;
    font-style: italic;
    color: var(--ink-soft);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 1.1rem;
    margin: 0.35rem 0 0;
    font-family: 'IM Fell English SC', serif;
    letter-spacing: 0.06em;
  }

  .links a {
    color: var(--rubric);
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
  }

  .bio {
    margin-top: clamp(8px, 1.8vh, 20px);
  }

  .lede,
  .more {
    font-size: clamp(1.02rem, 0.55vw + 0.62rem, 1.22rem);
    line-height: 1.5;
    max-width: 54ch;
    margin: 0 0 0.6rem;
    hyphens: auto;
    text-align: justify;
  }

  .more {
    color: var(--ink-soft);
  }

  .contents {
    margin-top: clamp(10px, 2vh, 24px);
  }

  .chapter > a {
    font-size: 1.1rem;
  }

  /* Lit from the forum: its building is under the pointer. */
  .contents a.is-lit {
    color: var(--rubric);
  }

  .sub {
    padding-left: 3.1ch !important;
    margin-bottom: 0.3rem !important;
  }

  .sub a {
    font-style: italic;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  /* ── Listening: the engraved cover beside its note ── */

  .listening {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-top: auto;
    padding-top: 12px;
  }

  .listening[hidden],
  .listening [hidden] {
    display: none;
  }

  .cover {
    flex: none;
    width: clamp(72px, 11vh, 124px);
    aspect-ratio: 1;
    margin: 6px;
    border: 1px solid var(--ink);
    outline: 1px solid var(--ink);
    outline-offset: 3px;
  }

  #cover {
    display: block;
    width: 100%;
    height: 100%;
  }

  .listening-text p {
    margin: 0;
    line-height: 1.3;
  }

  .listening em,
  .hand {
    color: var(--rubric);
  }

  .track {
    font-size: 1.25rem;
  }

  .by {
    font-style: italic;
    color: var(--ink-soft);
  }

  .watching {
    margin-top: 0.5rem !important;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  /* ── Shorter screens: shed the secondary lines first ── */

  @media (max-height: 760px) and (min-aspect-ratio: 1/1) {
    .more,
    .sub li:nth-child(n + 2),
    .watching {
      display: none;
    }
  }

  /* ── Portrait: one long page, name and links first, then the forum, then the rest ── */

  @media (max-aspect-ratio: 1/1) {
    .hint {
      display: none;
    }


    .cover {
      width: 72px;
    }
  }
</style>
