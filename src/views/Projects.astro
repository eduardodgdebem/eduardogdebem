---
// The projects' spread (/projects/, /pt/projetos/): the workshop on the left
// page, what's on its benches listed on the right.
import Codex from '../layouts/Codex.astro';
import Officina from '../components/Officina.astro';
import { PROJECTS, TYPES } from '../data/projects';
import { SITE_TITLE } from '../consts';
import { tr, type Lang } from '../i18n/strings';
import { PATHS } from '../i18n/paths';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = tr(lang);
const NUMERALS = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];
// Grouped by what they are, each keeping its index (its piece in the workshop).
const LATIN = { site: 'Paginae', app: 'Instrumenta', language: 'Linguae' } as const;
const roman = (n: number) =>
  ([['M', 1000], ['CM', 900], ['D', 500], ['CD', 400], ['C', 100], ['XC', 90], ['L', 50], ['XL', 40], ['X', 10], ['IX', 9], ['V', 5], ['IV', 4], ['I', 1]] as const).reduce(
    (acc, [sym, v]) => {
      while (acc.n >= v) {
        acc.out += sym;
        acc.n -= v;
      }
      return acc;
    },
    { n, out: '' },
  ).out;
const groups = TYPES.map((type) => ({ type, items: PROJECTS.map((p, i) => ({ p, i })).filter(({ p }) => p.type === type) })).filter((g) => g.items.length);
const META = {
  en: {
    title: `Projects — ${SITE_TITLE}`,
    description: 'Projects by Eduardo de Bem: sites for a salon in Florida, a chain of salons and a consultancy in Brazil, and Ode, a self-hosting programming language.',
  },
  pt: {
    title: `Projetos — ${SITE_TITLE}`,
    description: 'Projetos de Eduardo de Bem: sites para um salão na Flórida, uma rede de salões e uma consultoria no Brasil, e Ode, uma linguagem de programação que compila a si mesma.',
  },
}[lang];
---

<Codex lang={lang} alternates={PATHS.projects} title={META.title} description={META.description} at="projects">
  <Fragment slot="verso">
    <Officina lang={lang} />
  </Fragment>

  <Fragment slot="recto">
    <header class="head">
      <p class="rubric">Liber III · Officina</p>
      <h1 data-i18n="officina.title">{s('officina.title')}</h1>
      <p class="intro" data-i18n="officina.intro">{s('officina.intro')}</p>
    </header>

    <!-- By type, each a fold that opens and closes; a piece lit in the workshop opens its own. -->
    {groups.map(({ type, items }) => (
      <details class="group" open data-group={type}>
        <summary>
          <span class="group-latin">{LATIN[type]}</span>
          <span class="group-name" data-i18n={`officina.type.${type}`}>{s(`officina.type.${type}`)}</span>
          <span class="group-count">{roman(items.length)}</span>
          <span class="group-mark" aria-hidden="true">❧</span>
        </summary>
        <ol class="works">
          {items.map(({ p, i }) => (
            <li class="work" data-work={i} tabindex="-1">
              <p class="cap">
                <span class="num">{NUMERALS[i]}.</span> {p.latin}
                <span class="year">{roman(p.year)}</span>
              </p>
              <h3>
                <a href={p.url} target="_blank" rel="noopener noreferrer">{p.name}</a>
                <span class="kind">{p.kind[lang]}</span>
              </h3>
              {p.preview && (
                <div class="shot" aria-hidden="true">
                  <div class="shot-inner">
                    <figure>
                      <img src={p.preview} alt="" width="1280" height="800" loading="lazy" decoding="async" />
                    </figure>
                  </div>
                </div>
              )}
              <p class="summary">{p.summary[lang]}</p>
              {p.snippet && (
                <figure class="code-plate">
                  <figcaption><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>{p.snippet.file}</figcaption>
                  <pre><code>{p.snippet.code}</code></pre>
                </figure>
              )}
              <p class="foot">
                <span class="made">{p.stack.join(' · ')}</span>
                <span class="links">
                  {p.code && p.code !== p.url && <a href={p.code} target="_blank" rel="noopener noreferrer">{s('officina.code')} <span aria-hidden="true">↗</span></a>}
                  <a href={p.url} target="_blank" rel="noopener noreferrer">{p.code === p.url ? s('officina.code') : p.type === 'app' ? s('officina.app') : s('officina.site')} <span aria-hidden="true">↗</span></a>
                </span>
              </p>
              {p.note && <p class="note">{p.note[lang]}</p>}
            </li>
          ))}
        </ol>
      </details>
    ))}
    <p class="fleuron" aria-hidden="true">❦</p>
  </Fragment>
</Codex>

<style>
  .head h1 {
    font-size: clamp(2.4rem, 3.6vw, 3.6rem);
    margin: 0 0 0.4rem;
  }

  .intro {
    font-style: italic;
    color: var(--ink-soft);
    margin: 0 0 0.4rem;
  }

  /* ── A group: a fold under a heading ruled like a chapter's ── */

  .group {
    margin-top: 1.1rem;
    interpolate-size: allow-keywords;
  }

  .group summary {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.35rem 0 0.4rem;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    list-style: none;
    cursor: pointer;
    user-select: none;
  }

  .group summary::-webkit-details-marker {
    display: none;
  }

  .group-latin {
    font-family: var(--f-label);
    font-size: 1.2rem;
    letter-spacing: 0.12em;
    color: var(--rubric);
  }

  .group-name {
    font-style: italic;
    color: var(--ink-soft);
  }

  .group-count {
    margin-left: auto;
    font-family: var(--f-label);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }

  /* The fleuron turns down when the fold is open. */
  .group-mark {
    color: var(--rubric);
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .group[open] .group-mark {
    transform: rotate(90deg);
  }

  .group summary:hover .group-latin {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  /* Folding open and shut, where the browser can ease to a height of auto. */
  .group::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      content-visibility 0.45s allow-discrete;
  }

  .group[open]::details-content {
    block-size: auto;
  }

  .works {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ── An entry ── */

  .work {
    position: relative;
    padding: 0.85rem 0 0.8rem;
    border-bottom: 1px dotted var(--rule);
    outline: none;
  }

  .work:last-child {
    border-bottom: 0;
  }

  /* Lit from the workshop, or under the pointer: a manicule in the margin,
     the name in rubric, and the picture unfolds. */
  .work::before {
    content: '☞';
    position: absolute;
    left: -1.6em;
    top: 1.75rem;
    color: var(--rubric);
    opacity: 0;
    transform: translateX(-0.4em);
    transition:
      opacity 0.25s,
      transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .cap {
    display: flex;
    gap: 0.4rem;
    margin: 0;
    font-family: var(--f-label);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: var(--rubric);
  }

  .year {
    margin-left: auto;
    color: var(--ink-soft);
  }

  .work h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.6rem;
    margin: 0.05rem 0 0;
    font-size: clamp(1.4rem, 1.7vw, 1.7rem);
  }

  .work h3 a {
    text-decoration: none;
    transition: color 0.25s;
  }

  .kind {
    font-size: 0.95rem;
    font-style: italic;
    color: var(--ink-soft);
  }

  .summary {
    margin: 0.35rem 0 0.3rem;
    max-width: 60ch;
    line-height: 1.5;
    hyphens: auto;
    text-align: justify;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 1rem;
    margin: 0;
    font-size: 0.92rem;
  }

  .made {
    color: var(--ink-soft);
  }

  .foot .links {
    display: flex;
    gap: 1rem;
    margin-left: auto;
  }

  .foot a {
    font-family: var(--f-label);
    letter-spacing: 0.06em;
    color: var(--rubric);
    text-decoration: none;
  }

  .foot a:hover {
    text-decoration: underline;
  }

  .note {
    margin: 0.15rem 0 0;
    font-size: 0.88rem;
    font-style: italic;
    color: var(--ink-soft);
  }

  /* ── Code over an engraving: a few real lines of a project's source, in a
     window laid over one of the site's own plates, toned into the accent ── */

  .code-plate {
    position: relative;
    margin: 0.7rem 0 0.6rem;
    padding: clamp(18px, 3.2vw, 34px);
    border: 1px solid var(--line);
    background: var(--rubric);
    overflow: hidden;
  }

  .code-plate::before {
    content: '';
    position: absolute;
    /* Taller than its window, so it can drift as the page scrolls (nocturne.css). */
    inset: -12% 0;
    background: url('/projects/engraving.jpg') center 30% / cover;
    filter: grayscale(1) contrast(1.2);
    mix-blend-mode: multiply;
  }

  .code-plate figcaption,
  .code-plate pre {
    position: relative;
    width: min(100%, 24rem);
    margin: 0 auto;
    background: rgb(5 11 8 / 0.92);
  }

  .code-plate figcaption {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.45rem 0.7rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--f-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }

  .dots {
    display: flex;
    gap: 5px;
  }

  .dots i {
    width: 7px;
    height: 7px;
    border: 1px solid var(--ink-faint);
    border-radius: 50%;
  }

  .code-plate pre {
    padding: 0.8rem 0.9rem 0.9rem;
    overflow-x: auto;
  }

  .code-plate code {
    padding: 0;
    font-family: var(--f-mono);
    font-size: 0.74rem;
    line-height: 1.6;
    color: var(--ink);
    background: none;
  }

  /* ── The picture, always shown: a green duotone under a halftone screen,
     drifting a little as the page scrolls (nocturne.css) ── */

  .shot {
    display: grid;
  }

  .shot-inner {
    min-height: 0;
    overflow: hidden;
  }

  .shot figure {
    position: relative;
    width: min(100%, 26rem);
    margin: 0.55rem auto 0.35rem;
    padding: 0;
    border: 1px solid var(--line);
    /* A duotone in the accent: the picture's darks in the night, its lights in green. */
    background: var(--rubric);
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
    filter: grayscale(1) contrast(1.25) brightness(0.95);
    mix-blend-mode: multiply;
  }

  /* Over it, a halftone screen, so it's printed rather than shown. */
  .shot figure::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle, transparent 0.7px, rgb(5 11 8 / 0.5) 1.25px) 0 0 / 3px 3px;
  }

  .work.is-lit::before,
  .work:focus-within::before {
    opacity: 1;
    transform: none;
  }

  .work.is-lit h3 a,
  .work:focus-within h3 a {
    color: var(--rubric);
  }

  @media (hover: hover) {
    .work:hover::before {
      opacity: 1;
      transform: none;
    }

    .work:hover h3 a {
      color: var(--rubric);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work::before,
    .group-mark,
    .group::details-content {
      transition: none;
    }
  }
</style>
