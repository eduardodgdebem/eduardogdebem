---
// The projects' spread (/projects/, /pt/projetos/): the workshop on the left
// page, what's on its benches listed on the right.
import Codex from '../layouts/Codex.astro';
import Officina from '../components/Officina.astro';
import { PROJECTS, TYPES } from '../data/projects';
import { SITE_TITLE } from '../consts';
import { tr, type Lang } from '../i18n/strings';
import { PATHS } from '../i18n/paths';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = tr(lang);
const NUMERALS = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];
// Grouped by what they are, each keeping its index (its piece in the workshop).
const LATIN = { site: 'Paginae', language: 'Linguae' } as const;
const roman = (n: number) =>
  ([['M', 1000], ['CM', 900], ['D', 500], ['CD', 400], ['C', 100], ['XC', 90], ['L', 50], ['XL', 40], ['X', 10], ['IX', 9], ['V', 5], ['IV', 4], ['I', 1]] as const).reduce(
    (acc, [sym, v]) => {
      while (acc.n >= v) {
        acc.out += sym;
        acc.n -= v;
      }
      return acc;
    },
    { n, out: '' },
  ).out;
const groups = TYPES.map((type) => ({ type, items: PROJECTS.map((p, i) => ({ p, i })).filter(({ p }) => p.type === type) })).filter((g) => g.items.length);
const META = {
  en: {
    title: `Projects — ${SITE_TITLE}`,
    description: 'Projects by Eduardo de Bem: sites for a salon in Florida, a chain of salons and a consultancy in Brazil, and Ode, a self-hosting programming language.',
  },
  pt: {
    title: `Projetos — ${SITE_TITLE}`,
    description: 'Projetos de Eduardo de Bem: sites para um salão na Flórida, uma rede de salões e uma consultoria no Brasil, e Ode, uma linguagem de programação que compila a si mesma.',
  },
}[lang];
---

<Codex lang={lang} alternates={PATHS.projects} title={META.title} description={META.description} at="projects">
  <Fragment slot="verso">
    <Officina lang={lang} />
  </Fragment>

  <Fragment slot="recto">
    <header class="head">
      <p class="rubric">Liber III · Officina</p>
      <h1 data-i18n="officina.title">{s('officina.title')}</h1>
      <p class="intro" data-i18n="officina.intro">{s('officina.intro')}</p>
    </header>

    <!-- By type, each a fold that opens and closes; a piece lit in the workshop opens its own. -->
    {groups.map(({ type, items }) => (
      <details class="group" open data-group={type}>
        <summary>
          <span class="group-latin">{LATIN[type]}</span>
          <span class="group-name" data-i18n={`officina.type.${type}`}>{s(`officina.type.${type}`)}</span>
          <span class="group-count">{roman(items.length)}</span>
          <span class="group-mark" aria-hidden="true">❧</span>
        </summary>
        <ol class="works">
          {items.map(({ p, i }) => (
            <li class="work" data-work={i} tabindex="-1">
              <p class="cap">
                <span class="num">{NUMERALS[i]}.</span> {p.latin}
                <span class="year">{roman(p.year)}</span>
              </p>
              <h3>
                <a href={p.url} target="_blank" rel="noopener noreferrer">{p.name}</a>
                <span class="kind">{p.kind[lang]}</span>
              </h3>
              {p.preview && (
                <div class="shot" aria-hidden="true">
                  <div class="shot-inner">
                    <figure>
                      <img src={p.preview} alt="" width="1280" height="800" loading="lazy" decoding="async" />
                    </figure>
                  </div>
                </div>
              )}
              <p class="summary">{p.summary[lang]}</p>
              <p class="foot">
                <span class="made">{p.stack.join(' · ')}</span>
                <a href={p.url} target="_blank" rel="noopener noreferrer">{p.code === p.url ? s('officina.code') : s('officina.site')} <span aria-hidden="true">↗</span></a>
              </p>
              {p.note && <p class="note">{p.note[lang]}</p>}
            </li>
          ))}
        </ol>
      </details>
    ))}
    <p class="fleuron" aria-hidden="true">❦</p>
  </Fragment>
</Codex>

<style>
  .head h1 {
    font-size: clamp(2.4rem, 3.6vw, 3.6rem);
    margin: 0 0 0.4rem;
  }

  .intro {
    font-style: italic;
    color: var(--ink-soft);
    margin: 0 0 0.4rem;
  }

  /* ── A group: a fold under a heading ruled like a chapter's ── */

  .group {
    margin-top: 1.1rem;
    interpolate-size: allow-keywords;
  }

  .group summary {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.35rem 0 0.4rem;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    list-style: none;
    cursor: pointer;
    user-select: none;
  }

  .group summary::-webkit-details-marker {
    display: none;
  }

  .group-latin {
    font-family: var(--f-label);
    font-size: 1.2rem;
    letter-spacing: 0.12em;
    color: var(--rubric);
  }

  .group-name {
    font-style: italic;
    color: var(--ink-soft);
  }

  .group-count {
    margin-left: auto;
    font-family: var(--f-label);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }

  /* The fleuron turns down when the fold is open. */
  .group-mark {
    color: var(--rubric);
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .group[open] .group-mark {
    transform: rotate(90deg);
  }

  .group summary:hover .group-latin {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  /* Folding open and shut, where the browser can ease to a height of auto. */
  .group::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      content-visibility 0.45s allow-discrete;
  }

  .group[open]::details-content {
    block-size: auto;
  }

  .works {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ── An entry ── */

  .work {
    position: relative;
    padding: 0.85rem 0 0.8rem;
    border-bottom: 1px dotted var(--rule);
    outline: none;
  }

  .work:last-child {
    border-bottom: 0;
  }

  /* Lit from the workshop, or under the pointer: a manicule in the margin,
     the name in rubric, and the picture unfolds. */
  .work::before {
    content: '☞';
    position: absolute;
    left: -1.6em;
    top: 1.75rem;
    color: var(--rubric);
    opacity: 0;
    transform: translateX(-0.4em);
    transition:
      opacity 0.25s,
      transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .cap {
    display: flex;
    gap: 0.4rem;
    margin: 0;
    font-family: var(--f-label);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: var(--rubric);
  }

  .year {
    margin-left: auto;
    color: var(--ink-soft);
  }

  .work h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.6rem;
    margin: 0.05rem 0 0;
    font-size: clamp(1.4rem, 1.7vw, 1.7rem);
  }

  .work h3 a {
    text-decoration: none;
    transition: color 0.25s;
  }

  .kind {
    font-size: 0.95rem;
    font-style: italic;
    color: var(--ink-soft);
  }

  .summary {
    margin: 0.35rem 0 0.3rem;
    max-width: 60ch;
    line-height: 1.5;
    hyphens: auto;
    text-align: justify;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 1rem;
    margin: 0;
    font-size: 0.92rem;
  }

  .made {
    color: var(--ink-soft);
  }

  .foot a {
    margin-left: auto;
    font-family: var(--f-label);
    letter-spacing: 0.06em;
    color: var(--rubric);
    text-decoration: none;
  }

  .foot a:hover {
    text-decoration: underline;
  }

  .note {
    margin: 0.15rem 0 0;
    font-size: 0.88rem;
    font-style: italic;
    color: var(--ink-soft);
  }

  /* ── The picture: folded away until the entry is lit, then printed into
     the page: drained to the paper's ink, soft at its edges, in a ruled frame ── */

  .shot {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 0.35s;
  }

  .shot-inner {
    min-height: 0;
    overflow: hidden;
  }

  .shot figure {
    position: relative;
    width: min(100%, 26rem);
    margin: 0.55rem auto 0.35rem;
    padding: 5px;
    border: 1px solid var(--ink);
    outline: 1px solid var(--ink);
    outline-offset: 3px;
    background: var(--paper);
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
    /* Ink on paper: no colour of its own, the darks in the page's ink. */
    filter: grayscale(1) contrast(0.9) brightness(0.8);
    mix-blend-mode: luminosity;
    opacity: 0.78;
    /* Fading into the paper at the edges, as an old plate's tone does. */
    mask-image: radial-gradient(ellipse 72% 70% at 50% 45%, #000 55%, transparent 100%);
  }

  /* Over it, the paper's own grain and a warm tone, so it sits in the page. */
  .shot figure::after {
    content: '';
    position: absolute;
    inset: 5px;
    pointer-events: none;
    background:
      repeating-linear-gradient(115deg, transparent 0 2px, rgb(8 11 13 / 0.25) 2px 3px),
      linear-gradient(rgb(184 150 90 / 0.12), rgb(184 150 90 / 0.12));
    mix-blend-mode: multiply;
  }

  .work.is-lit .shot,
  .work:focus-within .shot {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .work.is-lit::before,
  .work:focus-within::before {
    opacity: 1;
    transform: none;
  }

  .work.is-lit h3 a,
  .work:focus-within h3 a {
    color: var(--rubric);
  }

  @media (hover: hover) {
    .work:hover .shot {
      grid-template-rows: 1fr;
      opacity: 1;
    }

    .work:hover::before {
      opacity: 1;
      transform: none;
    }

    .work:hover h3 a {
      color: var(--rubric);
    }
  }

  /* No hover on a phone: the pictures stay open. */
  @media (hover: none) {
    .shot {
      grid-template-rows: 1fr;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work::before,
    .shot,
    .group-mark,
    .group::details-content {
      transition: none;
    }
  }
</style>
