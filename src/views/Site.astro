---
// The one page, in English (/) or Portuguese (/pt/). A bar across the top,
// then sections each set its own way: a full-screen hero with Caesar, an
// deck of job cards that stack as the page scrolls, a grid of projects, a
// painting with a motto, the stack on the accent, about, and a contact page
// of one huge address. Behaviour is in src/scripts/site.ts.
import Shell from '../layouts/Shell.astro';
import Art from '../components/Art.astro';
import Logo from '../components/Logo.astro';
import { ICONS } from '../components/icons';
import { LOGOS } from '../data/logos';
import { ABOUT, CONTACT, META, NAV, NOTES, PATHS, SECTIONS, STACK, UI, WORK, t, type Lang } from '../data/site';
import { ART, type ArtId } from '../data/art';
import { PROJECTS, TYPES } from '../data/projects';
import { CV_PDF } from '../consts';
import { PERSON, WEBSITE } from '../seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const other: Lang = lang === 'en' ? 'pt' : 'en';
const pad = (n: number) => String(n).padStart(2, '0');
const sections = SECTIONS.filter((id) => id !== 'overview');
const num = (id: (typeof SECTIONS)[number]) => pad(sections.indexOf(id as (typeof sections)[number]) + 1);
const projects = TYPES.flatMap((type) => PROJECTS.filter((p) => p.type === type));
const TYPE_NAME = { site: { en: 'Site', pt: 'Site' }, app: { en: 'App', pt: 'App' }, language: { en: 'Language', pt: 'Linguagem' } };
const linkLabel = (p: (typeof PROJECTS)[number]) => (p.code === p.url ? s(UI.readCode) : p.type === 'app' ? s(UI.openApp) : s(UI.visit));
const ticker = STACK.flatMap((g) => g.items);
const credited = Object.entries(ART) as [ArtId, (typeof ART)[ArtId]][];
const [user, host] = CONTACT.email.split('@');
---

<Shell
  title={META[lang].title}
  description={META[lang].description}
  lang={lang}
  alternates={PATHS}
  schema={{ '@context': 'https://schema.org', '@graph': [WEBSITE, PERSON] }}
>
  <div class="frame" aria-hidden="true"></div>

  <!-- The bar across the top -->
  <header class="bar" data-bar>
    <a class="brand" href={PATHS[lang]}>
      <span class="brand-mark"><Logo size={18} /></span>
      <span class="brand-name">Eduardo de Bem</span>
    </a>
    <nav class="bar-nav" id="bar-nav" aria-label="Sections">
      <ol>
        {sections.map((id) => (
          <li><a href={`#${id}`} data-nav={id}><span class="bar-num">{num(id)}</span>{s(NAV[id])}</a></li>
        ))}
      </ol>
      <p class="bar-extra">
        <a href={CONTACT.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" set:html={ICONS.github} />
        <a href={CONTACT.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" set:html={ICONS.linkedin} />
        <span class="bar-lang">
          <a href={PATHS.en} hreflang="en" lang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
          <a href={PATHS.pt} hreflang="pt-BR" lang="pt-BR" aria-current={lang === 'pt' ? 'page' : undefined}>PT</a>
        </span>
      </p>
    </nav>
    <a class="button button--accent bar-cta" href="#contact">{s(UI.ctaContact)}</a>
    <button type="button" class="menu-button" aria-expanded="false" aria-controls="bar-nav" data-menu data-open={s(UI.menu)} data-close={s(UI.close)}>
      <span data-menu-label>{s(UI.menu)}</span><span class="menu-bars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </header>

  <main>
    <!-- Hero: Caesar, and one huge line -->
    <section class="hero" id="overview" data-section="overview">
      <div class="hero-art" aria-hidden="true">
        <svg class="rays" viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice">
          {Array.from({ length: 48 }, (_, i) => {
            const a = (i / 48) * Math.PI * 2;
            const r = i % 2 ? 640 : 900;
            return <path d={`M${500 + Math.cos(a) * 250},${430 + Math.sin(a) * 250}L${500 + Math.cos(a) * r},${430 + Math.sin(a) * r}`} />;
          })}
          <circle cx="500" cy="430" r="250" />
          <circle cx="500" cy="430" r="330" class="rays-dash" />
        </svg>
        <Art id="caesar" class="caesar" />
      </div>
      <p class="hero-meta hero-meta--tl"><span>{s(UI.role)}</span><span class="dim">{s(UI.place)}</span></p>
      <p class="hero-meta hero-meta--tr"><span>27°35′S</span><span>48°33′W</span></p>
      <h1 class="hero-title">
        <span class="sr-only">Eduardo de Bem: </span>
        {s(UI.headline).split(' ').map((w, i) => <span class="word" style={`--i:${i}`}><span>{w}</span></span>)}
      </h1>
      <div class="hero-foot">
        <p class="lede">{s(UI.lede)}</p>
        <p class="actions">
          <a class="button button--accent" href="#contact">{s(UI.ctaContact)}<Fragment set:html={ICONS.arrow} /></a>
          <a class="button button--line" href={CV_PDF} download>{s(UI.ctaCv)}<Fragment set:html={ICONS.download} /></a>
        </p>
      </div>
      <p class="hero-caption" aria-hidden="true">FIG. 00 — {ART.caesar.name} · {ART.caesar.where}</p>
      <div class="ticker" aria-hidden="true">
        <div class="ticker-track">
          {[0, 1].map(() => <span class="ticker-run">{ticker.map((x) => <span>{x}<i>✦</i></span>)}</span>)}
        </div>
      </div>
    </section>

    <!-- Work: a deck of cards, each held under the bar until the next one covers it -->
    <section class="section work" id="work" data-section="work">
      <div class="head-art" aria-hidden="true"><Art id="moses" /></div>
      <header class="head reveal">
        <p class="head-num">{num('work')}</p>
        <h2 class="head-title">{s(UI.workTitle)}</h2>
        <p class="head-kicker">// {s(NAV.work)}</p>
      </header>
      <ol class="deck">
        {WORK.map((job, i) => (
          <li class="slide" style={`--i:${i}`}>
            <div class="slide-art">
              <p class="slide-bar"><span>FIG. {pad(i + 1)}</span><span>{ART[job.art as ArtId].name}</span><span class="dim">{ART[job.art as ArtId].where}</span></p>
              <Art id={job.art as ArtId} class:list={['slide-pic', { 'slide-pic--whole': ART[job.art as ArtId].h > ART[job.art as ArtId].w * 1.2 }]} />
            </div>
            <div class="slide-body">
              <p class="slide-count"><span>{pad(i + 1)}</span><span class="dim">/ {pad(WORK.length)}</span></p>
              <p class="slide-when">{s(job.when)}</p>
              <h3 class="slide-title">{s(job.title)}</h3>
              <p class="slide-org">{job.org}</p>
              <p class="slide-text">{s(job.summary)}</p>
              <p class="tags">{job.stack.map((x) => <span>{x}</span>)}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Projects: a grid of windows -->
    <section class="section projects" id="projects" data-section="projects">
      <div class="head-art" aria-hidden="true"><Art id="melencolia" /></div>
      <header class="head reveal">
        <p class="head-num">{num('projects')}</p>
        <h2 class="head-title">{s(UI.projectsTitle)}</h2>
        <p class="head-kicker">// {s(NAV.projects)}</p>
        <p class="head-lede">{s(UI.projectsLede)}</p>
      </header>
      <div class="cards">
        {projects.map((p, i) => (
          <article class:list={['card reveal', { 'card--wide': i === 0 }]} id={p.id}>
            <a class="window" href={p.url} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
              <p class="window-bar"><span class="dots"><i></i><i></i><i></i></span><span>{p.preview ? p.host : p.snippet?.file}</span></p>
              {p.preview ? (
                <span class="shot"><img src={p.preview} alt="" width="1280" height="800" loading="lazy" decoding="async" /></span>
              ) : (
                <pre class="window-code"><code>{p.snippet?.code}</code></pre>
              )}
            </a>
            <div class="card-body">
              <p class="card-num">{pad(i + 1)} <span class="dim">· {p.latin} · {s(TYPE_NAME[p.type])}</span></p>
              <h3 class="card-title"><a href={p.url} target="_blank" rel="noopener noreferrer">{p.name}<Fragment set:html={ICONS.external} /></a></h3>
              <p class="card-text">{s(p.summary)}</p>
              <p class="tags">{p.stack.map((x) => <span>{x}</span>)}</p>
              <p class="links">
                {p.code && p.code !== p.url && <a href={p.code} target="_blank" rel="noopener noreferrer">{s(UI.readCode)}</a>}
                <a href={p.url} target="_blank" rel="noopener noreferrer">{linkLabel(p)}</a>
              </p>
              {p.note && <p class="note">{s(p.note)}</p>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- A painting across the screen, and a motto over it -->
    <section class="interlude" aria-label="Ars longa">
      <Art id="thames" class="interlude-art" />
      <div class="interlude-text">
        <p class="interlude-latin reveal">Ars longa,<br /><em>vita brevis.</em></p>
        <p class="interlude-note reveal">{s(UI.motto)}</p>
      </div>
      <p class="interlude-caption">{ART.thames.name} · {ART.thames.where}</p>
    </section>

    <!-- Stack: on the accent -->
    <section class="section stack-section" id="stack" data-section="stack">
      <div class="stack-art" aria-hidden="true"><Art id="carceri" /></div>
      <header class="head reveal">
        <p class="head-num">{num('stack')}</p>
        <h2 class="head-title">{s(UI.stackTitle)}</h2>
        <p class="head-kicker">// {s(NAV.stack)}</p>
        <p class="head-lede">{s(UI.stackLede)}</p>
      </header>
      <div class="stack-groups">
        {STACK.map((g) => (
          <div class="stack-group reveal">
            <p class="stack-head">{s(g.group)}</p>
            <ul>{g.items.map((x) => <li><span class="stack-logo" set:html={LOGOS[x] ?? ICONS.stack} />{x}</li>)}</ul>
          </div>
        ))}
      </div>
      <p class="stack-note reveal">+ {s(UI.stackNote)}</p>
    </section>

    <!-- About -->
    <section class="section about" id="about" data-section="about">
      <div class="about-art reveal"><Art id="gladiator-head" caption /></div>
      <div class="about-text">
        <header class="head head--tight reveal">
          <p class="head-num">{num('about')}</p>
          <h2 class="head-title">{s(UI.aboutTitle)}</h2>
          <p class="head-kicker">// {s(NAV.about)}</p>
        </header>
        {ABOUT[lang].map((para) => <p class="about-para reveal">{para}</p>)}
        <dl class="notes reveal">
          {NOTES.map((n) => (
            <div>
              <dt>{s(n.head)}</dt>
              <dd>{s(n.items)}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Contact: one huge address -->
    <section class="section contact" id="contact" data-section="contact">
      <div class="contact-art" aria-hidden="true"><Art id="venus" /></div>
      <header class="head reveal">
        <p class="head-num">{num('contact')}</p>
        <h2 class="head-title">{s(UI.contactTitle)}</h2>
        <p class="head-kicker">// {s(NAV.contact)}</p>
        <p class="head-lede">{s(UI.contactLede)}</p>
      </header>
      <a class="address reveal" href={`mailto:${CONTACT.email}`}><span>{user}</span><span class="address-at">@{host}</span></a>
      <p class="contact-actions reveal">
        <button type="button" class="button button--accent" data-copy={CONTACT.email} data-copied={s(UI.copied)}><Fragment set:html={ICONS.copy} /><span data-copy-label>{s(UI.copy)}</span></button>
        <a class="button button--line" href={CONTACT.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="button button--line" href={CONTACT.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a class="button button--line" href={CV_PDF} download>{s(UI.ctaCv)}</a>
      </p>
      <p class="contact-based reveal">{s(CONTACT.based)}</p>
    </section>
  </main>

  <footer class="foot">
    <div class="foot-credits">
      <p class="chip">{s(UI.credits)}</p>
      <ul class="credits">
        {credited.map(([, a]) => (
          <li>{a.source ? <a href={a.source} target="_blank" rel="noopener noreferrer">{a.name}</a> : a.name}<span class="dim">, {a.where}. {a.credit}.</span></li>
        ))}
      </ul>
    </div>
    <p class="foot-line">
      <span>© {new Date().getFullYear()} Eduardo de Bem</span>
      <a href={PATHS[other]} hreflang={other === 'pt' ? 'pt-BR' : 'en'}>{other === 'pt' ? 'Em português' : 'In English'}</a>
    </p>
    <p class="foot-name" aria-hidden="true">Eduardo de Bem</p>
  </footer>
</Shell>

<script>
  import '../scripts/site';
</script>
