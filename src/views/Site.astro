---
// The one page, in English (/) or Portuguese (/pt/). A bar across the top,
// then sections each set its own way: a full-screen hero with Caesar, a deck
// of project cards that stack as the page scrolls, a photograph with a motto,
// about (with the jobs and the stack), and contact beside Mercury. Behaviour is in src/scripts/site.ts.
import Shell from '../layouts/Shell.astro';
import Art from '../components/Art.astro';
import Logo from '../components/Logo.astro';
import { ICONS } from '../components/icons';
import { LOGOS } from '../data/logos';
import { ABOUT, CONTACT, META, NAV, NOTES, PATHS, SECTIONS, STACK, UI, WORK, t, type Lang } from '../data/site';
import { ART, type ArtId } from '../data/art';
import { PROJECTS, TYPES } from '../data/projects';
import { CV_PDF } from '../consts';
import { PERSON, WEBSITE } from '../seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const other: Lang = lang === 'en' ? 'pt' : 'en';
// Numbered the Roman way, as an inscription or a book's chapters would be.
const roman = (n: number) => ['', 'I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'][n] ?? String(n);
const sections = SECTIONS.filter((id) => id !== 'overview');
const num = (id: (typeof SECTIONS)[number]) => roman(sections.indexOf(id as (typeof sections)[number]) + 1);
const projects = TYPES.flatMap((type) => PROJECTS.filter((p) => p.type === type));
// His own work gets a card each; the sites made for others share the last one.
const own = projects.filter((p) => p.type !== 'site');
const sites = projects.filter((p) => p.type === 'site');
const cards = own.length + (sites.length ? 1 : 0);
// Their stacks together, without a name another one already contains (Cloudflare, beside Cloudflare Workers).
const siteStack = [...new Set(sites.flatMap((p) => p.stack))].filter((x, _, all) => !all.some((y) => y !== x && y.startsWith(x)));
const TYPE_NAME = { site: { en: 'Site', pt: 'Site' }, app: { en: 'App', pt: 'App' }, language: { en: 'Language', pt: 'Linguagem' } };
const linkLabel = (p: (typeof PROJECTS)[number]) => (p.code === p.url ? s(UI.readCode) : p.type === 'app' ? s(UI.openApp) : s(UI.visit));
// Only the pictures on the page are credited.
const SHOWN: ArtId[] = ['caesar-turn', 'melencolia', 'laocoon', 'gladiator-head', 'mercury'];
const credited = SHOWN.map((id) => [id, ART[id]] as const);
const [user, host] = CONTACT.email.split('@');
---

<Shell
  title={META[lang].title}
  description={META[lang].description}
  lang={lang}
  alternates={PATHS}
  schema={{ '@context': 'https://schema.org', '@graph': [WEBSITE, PERSON] }}
>
  <a class="skip" href="#main">{s(UI.skip)}</a>

  <!-- The bar across the top -->
  <header class="bar" data-bar>
    <a class="brand" href={PATHS[lang]}>
      <span class="brand-mark"><Logo size={18} /></span>
      <span class="brand-name">Eduardo de Bem</span>
    </a>
    <nav class="bar-nav" id="bar-nav" aria-label={s(UI.sections)}>
      <ol>
        {sections.map((id) => (
          <li><a href={`#${id}`} data-nav={id}><span class="bar-num">{num(id)}</span>{s(NAV[id])}</a></li>
        ))}
      </ol>
      <p class="bar-extra">
        <a href={CONTACT.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" set:html={ICONS.github} />
        <a href={CONTACT.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" set:html={ICONS.linkedin} />
        <span class="bar-lang">
          <a href={PATHS.en} hreflang="en" lang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
          <a href={PATHS.pt} hreflang="pt-BR" lang="pt-BR" aria-current={lang === 'pt' ? 'page' : undefined}>PT</a>
        </span>
      </p>
    </nav>
    <a class="button button--accent bar-cta" href="#contact">{s(UI.ctaContact)}</a>
    <button type="button" class="menu-button" aria-expanded="false" aria-controls="bar-nav" data-menu data-open={s(UI.menu)} data-close={s(UI.close)}>
      <span data-menu-label>{s(UI.menu)}</span><span class="menu-bars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </header>

  <main id="main" tabindex="-1">
    <!-- Hero: Caesar turning, and the name -->
    <section class="hero" id="overview" data-section="overview">
      <div class="hero-art" aria-hidden="true">
        <svg class="rays" viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice">
          <g class="rays-spin">
          {Array.from({ length: 24 }, (_, i) => {
            const a = (i / 24) * Math.PI * 2;
            const r = i % 2 ? 640 : 900;
            return <path d={`M${500 + Math.cos(a) * 250},${430 + Math.sin(a) * 250}L${500 + Math.cos(a) * r},${430 + Math.sin(a) * r}`} />;
          })}
          <circle cx="500" cy="430" r="250" />
          </g>
        </svg>
        <figure class="art caesar caesar-turn" data-turn="/art/caesar-turn.png" data-frames="36" data-cols="6">
          <div class="art-ink" role="img" aria-label={`${s(ART['caesar-turn'].name)}, ${s(ART['caesar-turn'].where)}`} style="--src:url(/art/caesar-still.png)"></div>
        </figure>
      </div>
      <h1 class="hero-title">
        {s(UI.headline).split(' ').map((w, i) => <span class="word" style={`--i:${i}`}><span>{w}</span></span>)}
      </h1>
      <div class="hero-foot">
        <p class="lede">{s(UI.lede)}</p>
        <p class="actions">
          <a class="button button--accent" href="#contact">{s(UI.ctaContact)}<Fragment set:html={ICONS.arrow} /></a>
          <a class="button button--line" href={CV_PDF} download>{s(UI.ctaCv)}<Fragment set:html={ICONS.download} /></a>
        </p>
      </div>
    </section>

    <!-- Projects: a deck of cards, each held under the bar until the next one covers it -->
    <section class="section projects" id="projects" data-section="projects">
      <div class="head-art" aria-hidden="true"><Art id="melencolia" lang={lang} /></div>
      <header class="head reveal">
        <p class="head-num">{num('projects')}</p>
        <h2 class="head-title">{s(UI.projectsTitle)}</h2>
        <p class="head-kicker">// {s(NAV.projects)}</p>
        <p class="head-lede">{s(UI.projectsLede)}</p>
      </header>
      <ol class="deck">
        {own.map((p, i) => (
          <li class="slide" style={`--i:${i}`} id={p.id}>
            <a class="window" href={p.url} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
              <p class="window-bar"><span class="dots"><i></i><i></i><i></i></span><span>{p.preview ? p.host : p.snippet?.file}</span></p>
              {p.preview ? (
                <span class="shot"><img src={p.preview} alt="" width="1280" height="800" loading="lazy" decoding="async" /></span>
              ) : (
                <pre class="window-code"><code>{p.snippet?.code}</code></pre>
              )}
            </a>
            <div class="slide-body">
              <p class="slide-count"><span>{roman(i + 1)}</span><span class="dim">/ {roman(cards)}</span></p>
              <p class="slide-when">{s(TYPE_NAME[p.type])}</p>
              <h3 class="slide-title"><a href={p.url} target="_blank" rel="noopener noreferrer">{p.name}</a></h3>
              <p class="slide-text">{s(p.short)}</p>
              <p class="slide-stack">{p.stack.join(' · ')}</p>
              <p class="links">
                {p.code && p.code !== p.url && <a href={p.code} target="_blank" rel="noopener noreferrer">{s(UI.readCode)}<Fragment set:html={ICONS.external} /></a>}
                <a href={p.url} target="_blank" rel="noopener noreferrer">{linkLabel(p)}<Fragment set:html={ICONS.external} /></a>
              </p>
            </div>
          </li>
        ))}
        {sites.length > 0 && (
          <li class="slide slide--sites" style={`--i:${own.length}`} id="sites">
            <div class="mosaic">
              {sites.map((p) => (
                <a class="window" href={p.url} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
                  <p class="window-bar"><span class="dots"><i></i><i></i><i></i></span><span>{p.host}</span></p>
                  <span class="shot"><img src={p.preview} alt="" width="1280" height="800" loading="lazy" decoding="async" /></span>
                </a>
              ))}
            </div>
            <div class="slide-body">
              <p class="slide-count"><span>{roman(cards)}</span><span class="dim">/ {roman(cards)}</span></p>
              <p class="slide-when">{s(UI.sitesKind)}</p>
              <h3 class="slide-title">{s(UI.sitesTitle)}</h3>
              <ul class="site-list">
                {sites.map((p) => (
                  <li>
                    <a href={p.url} target="_blank" rel="noopener noreferrer">{p.name}<Fragment set:html={ICONS.external} /></a>
                    <span>{s(p.short)}</span>
                  </li>
                ))}
              </ul>
              <p class="slide-stack">{siteStack.join(' · ')}</p>
            </div>
          </li>
        )}
      </ol>
    </section>

    <!-- A photograph across the screen, in greys with a heavy grain, and a motto over it -->
    <div class="key" aria-hidden="true"></div>
    <section class="interlude" aria-label="Festina lente">
      <img class="interlude-photo" src="/art/laocoon-mono.jpg" alt="" width="2000" height="1063" loading="lazy" decoding="async" />
      <div class="interlude-text">
        <p class="interlude-latin reveal">Festina<br /><em>lente.</em></p>
        <p class="interlude-gloss reveal">{s(UI.festina)}</p>
      </div>
      <p class="interlude-caption">{s(ART.laocoon.name)} · {s(ART.laocoon.where)}</p>
    </section>
    <div class="key" aria-hidden="true"></div>

    <!-- About: who, where I've worked, what with -->
    <section class="section about" id="about" data-section="about">
      <div class="about-art reveal"><Art id="gladiator-head" caption lang={lang} /></div>
      <div class="about-text">
        <header class="head head--tight reveal">
          <p class="head-num">{num('about')}</p>
          <h2 class="head-title">{s(UI.aboutTitle)}</h2>
          <p class="head-kicker">// {s(NAV.about)}</p>
        </header>
        {ABOUT[lang].map((para) => <p class="about-para reveal">{para}</p>)}

        <h3 class="sub reveal">{s(UI.workTitle)}</h3>
        <ol class="jobs">
          {WORK.map((job) => (
            <li class="job reveal">
              <p class="job-when">{s(job.when)}</p>
              <div>
                <p class="job-title">{s(job.title)} <span class="job-org">· {job.org}</span></p>
                <p class="job-text">{s(job.summary)}</p>
              </div>
            </li>
          ))}
        </ol>

        <h3 class="sub reveal">{s(UI.stackTitle)}</h3>
        <ul class="logos reveal">
          {STACK.flatMap((g) => g.items).map((x) => <li><span class="logo" set:html={LOGOS[x] ?? ICONS.stack} />{x}</li>)}
        </ul>

        <dl class="notes reveal">
          {NOTES.map((n) => (
            <div>
              <dt>{s(n.head)}</dt>
              <dd>{s(n.items)}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Contact: Mercury, the messenger, beside the ways to reach me -->
    <section class="section contact" id="contact" data-section="contact">
      <div class="contact-main">
        <header class="head head--tight reveal">
          <p class="head-num">{num('contact')}</p>
          <h2 class="head-title">{s(UI.contactTitle)}</h2>
          <p class="head-kicker">// {s(NAV.contact)}</p>
        </header>
        <p class="contact-lede reveal">{s(UI.contactLede)}</p>
        <div class="mail reveal">
          <p class="mail-bar"><span>mailto</span><span>{s(CONTACT.based)}</span></p>
          <p class="mail-line">
            <a href={`mailto:${CONTACT.email}`}><span>{user}</span><span class="mail-host">@{host}</span></a>
            <button type="button" class="mail-copy" data-copy={CONTACT.email} data-copied={s(UI.copied)} aria-label={s(UI.copy)}><Fragment set:html={ICONS.copy} /><span data-copy-label>{s(UI.copy)}</span></button>
          </p>
        </div>
        <ul class="ways reveal">
          <li><a href={CONTACT.linkedin} target="_blank" rel="noopener noreferrer"><span class="ways-icon" set:html={ICONS.linkedin} /><span class="ways-name">LinkedIn</span><span class="ways-go" set:html={ICONS.external} /></a></li>
          <li><a href={CONTACT.github} target="_blank" rel="noopener noreferrer"><span class="ways-icon" set:html={ICONS.github} /><span class="ways-name">GitHub</span><span class="ways-go" set:html={ICONS.external} /></a></li>
          <li><a href={CV_PDF} download><span class="ways-icon" set:html={ICONS.cv} /><span class="ways-name">{s(UI.ctaCv)}</span><span class="ways-go" set:html={ICONS.download} /></a></li>
        </ul>
      </div>
      <figure class="contact-art reveal" aria-hidden="true">
        <svg class="orbit" viewBox="0 0 400 400">
          <circle cx="200" cy="200" r="190" />
          <circle cx="200" cy="200" r="140" class="orbit-dash" />
          <path d="M200 0V400M0 200H400" />
        </svg>
        <Art id="mercury" class="mercury" lang={lang} />
        <figcaption><span>{s(ART.mercury.name)}</span><span>{s(ART.mercury.where)}</span></figcaption>
      </figure>
    </section>
  </main>

  <footer class="foot">
    <div class="foot-close">
      <p class="foot-close-title">{s(UI.motto)}</p>
      <a class="button button--accent" href={`mailto:${CONTACT.email}`}>{CONTACT.email}<Fragment set:html={ICONS.arrow} /></a>
    </div>
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="brand" href={PATHS[lang]}><span class="brand-mark"><Logo size={18} /></span><span class="brand-name">Eduardo de Bem</span></a>
        <p class="foot-motto">{s(UI.role)} · {s(UI.place)}</p>
      </div>
      <nav class="foot-col" aria-label={s(UI.sections)}>
        <p class="foot-head">{s(UI.explore)}</p>
        <ul>{sections.map((id) => <li><a href={`#${id}`}>{s(NAV[id])}</a></li>)}</ul>
      </nav>
      <div class="foot-col">
        <p class="foot-head">{s(UI.elsewhere)}</p>
        <ul>
          <li><a href={CONTACT.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a href={CONTACT.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
          <li><a href={`mailto:${CONTACT.email}`}>{s(UI.email)}</a></li>
          <li><a href={CV_PDF} download>{s(UI.ctaCv)}</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <p class="foot-head">{s(UI.language)}</p>
        <ul>
          <li><a href={PATHS.en} hreflang="en" aria-current={lang === 'en' ? 'page' : undefined}>English</a></li>
          <li><a href={PATHS.pt} hreflang="pt-BR" aria-current={lang === 'pt' ? 'page' : undefined}>Português</a></li>
        </ul>
      </div>
    </div>
    <div class="foot-credits">
      <p class="foot-head">{s(UI.credits)}</p>
      <ul class="credits">
        {credited.map(([, a]) => (
          <li>{a.source ? <a href={a.source} target="_blank" rel="noopener noreferrer">{s(a.name)}</a> : s(a.name)}<span class="dim"> — {s(a.where)}. {s(a.credit)}.</span></li>
        ))}
      </ul>
    </div>
    <p class="foot-line">
      <span>© {new Date().getFullYear()} Eduardo de Bem</span>
      <a href="#overview" class="foot-top">{s(UI.top)} ↑</a>
    </p>
    <!-- The name cut in the marble as Caesar's is on his pedestal: C · IVLIO · CAESARI -->
    <p class="foot-name" aria-hidden="true">EDVARDVS<span>·</span>DE<span>·</span>BEM</p>
  </footer>
</Shell>

<script>
  import '../scripts/site';
</script>
