---
// The games, in English (/ludus/) or Portuguese (/pt/ludus/). The game is
// played on the plate itself: coins at its head, a badge over every cohort,
// a tray of soldiers to drag onto the sand, a formation picker for the cohort
// in hand, one big button to fight and then to sound the horn. The facing page
// says how to play, in icons, and keeps the annals.
// The game is src/scripts/codex/ludus/ (sim.ts fights it, ludus.ts draws it).
import Codex from '../layouts/Codex.astro';
import PlateTools from '../components/PlateTools.astro';
import { ICONS } from '../components/icons';
import { SITE_TITLE } from '../consts';
import { tr, type Lang, type StringKey } from '../i18n/strings';
import { PATHS } from '../i18n/paths';
import { BUDGET, COST, MAX_COHORTS, ROMAN_KINDS } from '../scripts/codex/ludus/sim';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = tr(lang);
const k = (key: string) => key as StringKey;
const META = {
  en: {
    title: `Ludus: a battle in the arena — ${SITE_TITLE}`,
    description: 'A small game in the arena: set out a Roman legion, cohort by cohort, against a Gallic host, and watch the battle play out.',
  },
  pt: {
    title: `Ludus: uma batalha na arena — ${SITE_TITLE}`,
    description: 'Um pequeno jogo na arena: arme uma legião romana, coorte por coorte, contra uma horda gaulesa, e veja a batalha acontecer.',
  },
}[lang];
const FORMATIONS = ['acies', 'testudo', 'cuneus', 'orbis'] as const;
// The wreath round a victory's title: two branches along a circle, from the
// stem at the bottom up either side, leaves pointing up the branch.
const LAUREL = {
  cx: 60,
  cy: 30,
  r: 27,
  at(side: number, a: number) {
    // a: 0 at the bottom, rising to 150° near the top on each side.
    const rad = ((90 + side * a) * Math.PI) / 180;
    return { x: this.cx + Math.cos(rad) * this.r, y: this.cy + Math.sin(rad) * this.r };
  },
  path(side: number) {
    const p0 = this.at(side, 8);
    const p1 = this.at(side, 150);
    return `M${p0.x.toFixed(1)} ${p0.y.toFixed(1)} A${this.r} ${this.r} 0 0 ${side > 0 ? 1 : 0} ${p1.x.toFixed(1)} ${p1.y.toFixed(1)}`;
  },
  leaves(side: number) {
    return Array.from({ length: 8 }, (_, i) => {
      const a = 20 + i * 17;
      const out = i % 2 ? 4 : -4; // alternately outside and inside the branch
      const p = this.at(side, a);
      const rad = ((90 + side * a) * Math.PI) / 180;
      const x = p.x + Math.cos(rad) * out;
      const y = p.y + Math.sin(rad) * out;
      // Tangent to the circle, tipped toward the top.
      const tangent = 90 + side * a + side * 90;
      return { x: +x.toFixed(1), y: +y.toFixed(1), a: Math.round(tangent + side * out * 6) };
    });
  },
};
const PRESETS = [['triplex', 'Triplex acies'], ['testudo', 'Testudo'], ['cuneus', 'Cuneus'], ['orbis', 'Orbis']] as const;
---

<Codex lang={lang} alternates={PATHS.ludus} title={META.title} description={META.description} folio={9}>
  <Fragment slot="verso">
    <figure class="plate">
      <div class="plate-frame ludus-frame">
        <canvas class="plate-canvas ludus-canvas" data-ludus aria-hidden="true"></canvas>
        <div class="plate-fallback" aria-hidden="true"><span>Ludus</span></div>

        <!-- The head of the plate: what's spent, and how the sides stand. -->
        <div class="hud-top">
          <span class="purse" data-purse title={s('ludus.treasury')}>
            <span class="ic" set:html={ICONS.coin} /><b data-spent>0</b>/{BUDGET}
            <span class="sep">·</span>
            <span class="ic" set:html={ICONS.legionarius} /><b data-count>0</b>/{MAX_COHORTS}
          </span>
          <span class="tally" data-tally hidden>
            <span class="side roma" title={s('ludus.roma')}><i></i><b data-roma>0</b></span>
            <span class="clock" data-time>0:00</span>
            <span class="side gallia" title={s('ludus.gallia')}><i></i><b data-gallia>0</b></span>
          </span>
        </div>

        <!-- A badge over every cohort: what it is, and how much of it is left. -->
        <div class="badges" data-badges></div>

        <!-- The cohort in hand: its formation, or send it away. -->
        <div class="forms" data-forms hidden>
          {FORMATIONS.map((f) => (
            <button type="button" data-formation={f} aria-label={s(k(`ludus.form.${f}`))} title={s(k(`ludus.form.${f}`))} set:html={ICONS[f]} />
          ))}
          <button type="button" class="drop" data-remove aria-label={s('ludus.remove')} title={s('ludus.remove')} set:html={ICONS.trash} />
        </div>

        <!-- The tray: soldiers to drag onto the sand (or pick, then tap a ring). -->
        <div class="tray" data-tray role="group" aria-label={s('ludus.tray')}>
          {ROMAN_KINDS.map((kind, i) => (
            <button type="button" class="tile" data-kind={kind} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`${s(k(`ludus.kind.${kind}`))}, ${COST[kind]}`} title={s(k(`ludus.kind.${kind}`))}>
              <span class="ic" set:html={ICONS[kind]} />
              <span class="price"><span class="ic" set:html={ICONS.coin} />{COST[kind]}</span>
            </button>
          ))}
        </div>

        <!-- One button: fight, then the horn. -->
        <button type="button" class="go" data-go aria-label="Pugnate!" title="Pugnate!">
          <span class="ic" data-go-icon set:html={ICONS.fight} />
          <span class="go-label" data-go-label>Pugnate!</span>
        </button>

        <!-- When it's over. -->
        <div class="petals" data-petals aria-hidden="true"></div>
        <div class="verdict" data-verdict hidden>
          <svg class="laurel" viewBox="0 0 120 64" aria-hidden="true">
            {[-1, 1].map((side) => (
              <g class="branch">
                <path d={LAUREL.path(side)} />
                {LAUREL.leaves(side).map((l, i) => (
                  <ellipse class="leaf" style={`--i:${i}`} cx={l.x} cy={l.y} rx="5.2" ry="2" transform={`rotate(${l.a} ${l.x} ${l.y})`} />
                ))}
              </g>
            ))}
          </svg>
          <p class="verdict-title" data-verdict-title></p>
          <p class="verdict-note" data-verdict-note></p>
          <p class="verdict-actions">
            <button type="button" class="again" data-again><span class="ic" set:html={ICONS.again} /> <span data-i18n="ludus.again">{s('ludus.again')}</span></button>
            <button type="button" data-replan><span data-i18n="ludus.replan">{s('ludus.replan')}</span></button>
          </p>
        </div>

        <div class="message" data-message role="status" aria-live="polite"></div>
        <PlateTools lang={lang} />
      </div>
      <figcaption class="plate-caption">
        <span class="tab">Tab. VI</span>
        <span class="cap-latin">Amphitheatrum</span>
        <span class="cap-note" data-i18n="ludus.note">{s('ludus.note')}</span>
      </figcaption>
    </figure>
  </Fragment>

  <Fragment slot="recto">
    <p class="rubric">Liber IV · Ludus</p>
    <h1 data-i18n="ludus.title">{s('ludus.title')}</h1>
    <p class="intro" data-i18n="ludus.intro">{s('ludus.intro')}</p>

    <ol class="how">
      <li><span class="ic big" set:html={ICONS.legionarius} /><span data-i18n="ludus.how.drag">{s('ludus.how.drag')}</span></li>
      <li><span class="ic big" set:html={ICONS.testudo} /><span data-i18n="ludus.how.tap">{s('ludus.how.tap')}</span></li>
      <li><span class="ic big" set:html={ICONS.fight} /><span data-i18n="ludus.how.fight">{s('ludus.how.fight')}</span></li>
    </ol>

    <h2 class="rubric small" data-i18n="ludus.beats">{s('ludus.beats')}</h2>
    <ul class="beats">
      {ROMAN_KINDS.map((kind) => (
        <li>
          <span class="ic" set:html={ICONS[kind]} />
          <b data-i18n={k(`ludus.kind.${kind}`)}>{s(k(`ludus.kind.${kind}`))}</b>
          <span data-i18n={k(`ludus.beats.${kind}`)}>{s(k(`ludus.beats.${kind}`))}</span>
        </li>
      ))}
    </ul>
    <ul class="beats forms-key">
      {FORMATIONS.map((f) => (
        <li>
          <span class="ic" set:html={ICONS[f]} />
          <b data-i18n={k(`ludus.form.${f}`)}>{s(k(`ludus.form.${f}`))}</b>
          <span data-i18n={k(`ludus.form.${f}.note`)}>{s(k(`ludus.form.${f}.note`))}</span>
        </li>
      ))}
    </ul>

    <p class="presets">
      <span class="label" data-i18n="ludus.presets">{s('ludus.presets')}</span>
      {PRESETS.map(([id, name]) => <button type="button" data-preset={id}>{name}</button>)}
    </p>
    <p class="presets">
      <button type="button" data-clear data-i18n="ludus.clear">{s('ludus.clear')}</button>
      <button type="button" data-share data-i18n="ludus.share">{s('ludus.share')}</button>
    </p>

    <h2 class="rubric small">Annales</h2>
    <ol class="annales" data-annales aria-live="polite"></ol>
  </Fragment>
</Codex>

<script>
  import { ICONS } from '../components/icons';
  import { createLudus, type Ludus, type Marker } from '../scripts/codex/ludus/ludus';
  import {
    ALLOWED,
    BUDGET,
    COST,
    MAX_COHORTS,
    cost,
    count,
    decode,
    encode,
    preset,
    SLOTS,
    type Battle,
    type Event,
    type Formation,
    type Plan,
    type RomanKind,
  } from '../scripts/codex/ludus/sim';
  import { bookOpened } from '../scripts/codex/opening';
  import { t } from '../scripts/codex/lang';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const canvas = $<HTMLCanvasElement>('[data-ludus]');
  const frame = canvas.parentElement!;
  const badgeLayer = $('[data-badges]');
  const formsBar = $('[data-forms]');
  const tray = $('[data-tray]');
  const tiles = [...document.querySelectorAll<HTMLButtonElement>('.tile')];
  const go = $<HTMLButtonElement>('[data-go]');
  const verdict = $('[data-verdict]');
  const annales = $('[data-annales]');
  const message = $('[data-message]');

  const roman = (n: number) =>
    ([['X', 10], ['IX', 9], ['V', 5], ['IV', 4], ['I', 1]] as const).reduce(
      (acc, [sym, v]) => {
        while (acc.n >= v) {
          acc.out += sym;
          acc.n -= v;
        }
        return acc;
      },
      { n, out: '' },
    ).out;

  // Ready to play: the triple line is already on the sand (or a shared plan).
  let plan: Plan = decode(new URLSearchParams(location.hash.slice(1)).get('plan') ?? '') ?? preset('triplex');
  let selected: number | null = null;
  let current: Battle | null = null;
  let hand: RomanKind = 'legionarius';
  let ludus: Ludus | null = null;

  const fits = (next: Plan) => cost(next) <= BUDGET && count(next) <= MAX_COHORTS;
  const say = (text: string) => {
    message.textContent = text;
    message.classList.add('is-shown');
    clearTimeout(sayT);
    sayT = setTimeout(() => message.classList.remove('is-shown'), 2400);
  };
  let sayT: ReturnType<typeof setTimeout> | undefined;

  /** Keep the purse, the tray and the plate in step with the plan. */
  const refresh = () => {
    $('[data-spent]').textContent = String(cost(plan));
    $('[data-count]').textContent = String(count(plan));
    const left = BUDGET - cost(plan);
    tiles.forEach((b) => {
      const kind = b.dataset.kind as RomanKind;
      b.setAttribute('aria-pressed', String(kind === hand));
      b.classList.toggle('is-dear', COST[kind]! > left);
    });
    go.disabled = !current && count(plan) === 0;
    formsBar.hidden = selected === null || !!current;
    if (selected !== null && plan[selected]) {
      for (const b of formsBar.querySelectorAll<HTMLButtonElement>('[data-formation]')) {
        const f = b.dataset.formation as Formation;
        b.disabled = !ALLOWED[plan[selected]!.kind].includes(f);
        b.setAttribute('aria-pressed', String(plan[selected]!.formation === f));
      }
    }
    ludus?.setPlan(plan, current ? null : selected);
  };

  /** Put a soldier of the hand's kind at a place (replacing what's there), if the purse allows. */
  const place = (slot: number, kind: RomanKind) => {
    const next = [...plan];
    const was = plan[slot];
    next[slot] = { kind, formation: was && ALLOWED[kind].includes(was.formation) ? was.formation : 'acies' };
    if (!fits(next)) {
      say(t('ludus.full'));
      return false;
    }
    plan = next;
    return true;
  };

  // Tapping a ring: pick out what's there, or set down the soldier in hand.
  const pick = (slot: number) => {
    if (current) return;
    if (plan[slot]) selected = selected === slot ? null : slot;
    else if (place(slot, hand)) selected = null;
    refresh();
  };

  /* ── Drag and drop: from the tray onto a ring; a cohort to another ring, or off the sand ── */

  const ghost = document.createElement('div');
  ghost.className = 'ghost';
  ghost.hidden = true;
  // Inside the plate, so it shows when the plate is at full screen.
  frame.append(ghost);
  /** Dropped outside the plate altogether: a cohort is sent away. */
  const offPlate = (x: number, y: number) => {
    const r = canvas.getBoundingClientRect();
    return x < r.left || x > r.right || y < r.top || y > r.bottom;
  };
  type Drag = { from: 'tray'; kind: RomanKind } | { from: 'slot'; slot: number };
  let drag: (Drag & { x0: number; y0: number; moved: boolean; id: number }) | null = null;

  const startDrag = (e: PointerEvent, what: Drag, icon: string) => {
    if (current || e.button !== 0) return;
    // A drag, not a text selection.
    e.preventDefault();
    drag = { ...what, x0: e.clientX, y0: e.clientY, moved: false, id: e.pointerId };
    ghost.innerHTML = icon;
    ghost.dataset.from = what.from;
  };
  window.addEventListener('pointermove', (e) => {
    if (!drag || e.pointerId !== drag.id) return;
    if (!drag.moved && Math.hypot(e.clientX - drag.x0, e.clientY - drag.y0) < 6) return;
    drag.moved = true;
    ghost.hidden = false;
    ghost.style.transform = `translate(${e.clientX}px, ${e.clientY}px)`;
    const slot = ludus?.slotAt(e.clientX, e.clientY) ?? null;
    ludus?.hover(slot);
    // Off the plate, a cohort being dragged would be sent away.
    ghost.classList.toggle('is-leaving', drag.from === 'slot' && offPlate(e.clientX, e.clientY));
  });
  window.addEventListener('pointerup', (e) => {
    if (!drag || e.pointerId !== drag.id) return;
    const d = drag;
    drag = null;
    ghost.hidden = true;
    ludus?.hover(null);
    if (!d.moved) {
      // A tap: on a tile, take that kind in hand; on a badge, pick the cohort out.
      if (d.from === 'tray') hand = d.kind;
      else selected = selected === d.slot ? null : d.slot;
      return refresh();
    }
    const slot = ludus?.slotAt(e.clientX, e.clientY) ?? null;
    if (d.from === 'tray') {
      hand = d.kind;
      if (slot !== null && place(slot, d.kind)) selected = null;
    } else if (offPlate(e.clientX, e.clientY)) {
      plan = plan.map((p, i) => (i === d.slot ? null : p));
      selected = null;
    } else if (slot !== null && slot !== d.slot) {
      // Onto another ring: move there, trading places with whatever stood there.
      const next = [...plan];
      [next[slot], next[d.slot]] = [plan[d.slot], plan[slot]];
      plan = next;
      selected = slot;
    }
    refresh();
  });
  for (const tile of tiles) {
    tile.addEventListener('pointerdown', (e) => startDrag(e, { from: 'tray', kind: tile.dataset.kind as RomanKind }, ICONS[tile.dataset.kind as RomanKind]));
    // Keyboard: Enter takes the kind in hand (then a tap or click on a ring sets it down).
    tile.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      e.preventDefault();
      hand = tile.dataset.kind as RomanKind;
      refresh();
    });
  }

  // The cohort in hand: its formation, or away with it.
  for (const b of formsBar.querySelectorAll<HTMLButtonElement>('[data-formation]')) {
    b.addEventListener('click', () => {
      if (selected === null || !plan[selected]) return;
      plan = plan.map((p, i) => (i === selected && p ? { ...p, formation: b.dataset.formation as Formation } : p));
      refresh();
    });
  }
  $('[data-remove]').addEventListener('click', () => {
    if (selected === null) return;
    plan = plan.map((p, i) => (i === selected ? null : p));
    selected = null;
    refresh();
  });

  /* ── Badges over the cohorts ── */

  const badges = new Map<string, HTMLElement>();
  const onMarkers = (markers: Marker[]) => {
    const seen = new Set<string>();
    for (const m of markers) {
      const key = `${current ? 'b' : 'p'}${m.side}${m.id}`;
      seen.add(key);
      let el = badges.get(key);
      if (!el) {
        el = document.createElement('span');
        el.className = `badge ${m.side}`;
        el.innerHTML = `<span class="ic">${ICONS[(m.side === 'roma' ? m.kind : GAUL_ICON[m.kind]) as keyof typeof ICONS]}</span><i class="bar"><i></i></i>`;
        // In planning, a Roman badge is the handle: drag it to another ring, or off the sand; tap to pick it out.
        if (m.side === 'roma' && !current) {
          const slot = m.id;
          el.addEventListener('pointerdown', (e) => startDrag(e, { from: 'slot', slot }, ICONS[m.kind as RomanKind]));
        }
        badgeLayer.append(el);
        badges.set(key, el);
      }
      el.style.transform = `translate(${m.x}px, ${m.y}px)`;
      el.classList.toggle('is-lit', !current && m.side === 'roma' && m.id === selected);
      el.classList.toggle('is-broken', m.broken);
      el.classList.toggle('is-planning', !current && m.side === 'roma');
      (el.querySelector('.bar > i') as HTMLElement).style.width = `${Math.round(m.strength * 100)}%`;
      // The formation picker sits under the cohort in hand.
      if (!current && m.side === 'roma' && m.id === selected) formsBar.style.transform = `translate(${m.x}px, ${m.y + 30}px)`;
    }
    for (const [key, el] of badges) {
      if (seen.has(key)) continue;
      el.remove();
      badges.delete(key);
    }
  };
  // A Gaul's badge shows what his men are, in Roman terms: warriors, slingers, horse, spears.
  const GAUL_ICON: Record<string, string> = { gallus: 'legionarius', funditor: 'sagittarius', equesGallus: 'eques', hastatus: 'triarius' };

  /* ── The battle, and its annals ── */

  const nameOf = (b: Battle, id: number) => {
    const c = b.cohorts[id];
    if (c.side === 'roma') return `Cohors ${roman(c.n)} ${t('ludus.kindOf')} ${t(`ludus.kind.${c.kind}`).toLowerCase()}`;
    if (c.kind === 'hastatus') return t('gaul.hastatus');
    const nth = b.cohorts.filter((o) => o.side === 'gallia' && o.kind === c.kind && o.id <= c.id).length;
    return `${t(`gaul.${c.kind}`)} ${roman(nth)}`;
  };
  const clock = (sec: number) => `${Math.floor(sec / 60)}:${String(Math.floor(sec % 60)).padStart(2, '0')}`;

  /** A line in the annals, written in a word at a time. */
  const write = (text: string, strong = false) => {
    const li = document.createElement('li');
    if (strong) li.className = 'end';
    const time = document.createElement('span');
    time.className = 'at';
    time.textContent = clock(current?.t ?? 0);
    li.append(time, ' ');
    text.split(/(\s+)/).forEach((w, i) => {
      if (/^\s+$/.test(w) || !w) return li.append(w);
      const span = document.createElement('span');
      span.className = reduced ? '' : 'quill quill-word';
      span.style.setProperty('--d', `${i * 22}ms`);
      span.textContent = w;
      li.append(span);
    });
    annales.prepend(li);
  };

  const onEvent = (e: Event, b: Battle) => {
    const fill = (key: string, a?: number, c?: number) =>
      t(key)
        .replace('{a}', a === undefined ? '' : nameOf(b, a))
        .replace('{b}', c === undefined ? '' : nameOf(b, c));
    if (e.type === 'start') write(t('log.start'));
    else if (e.type === 'contact' || e.type === 'flank' || e.type === 'rear') {
      // Front-to-front meetings only from the Roman side, to keep the annals readable.
      if (e.type !== 'contact' || b.cohorts[e.a].side === 'roma') write(fill(`log.${e.type}`, e.a, e.b));
    } else if (e.type === 'broken' || e.type === 'destroyed') write(fill(`log.${e.type}`, e.a));
    else if (e.type === 'horn') write(t(`log.${e.call}`), true);
    else if (e.type === 'end') {
      write(t(`log.${e.result}`), true);
      const [title, note] = t(`log.${e.result}`).split(/\.\s+/);
      $('[data-verdict-title]').textContent = title.replace(/\.$/, '') + (e.result === 'vicisti' ? '!' : '');
      $('[data-verdict-note]').textContent = note ?? '';
      verdict.dataset.result = e.result;
      verdict.hidden = false;
      if (e.result === 'vicisti') rain();
      go.hidden = true;
    }
  };

  /** Rose petals over the arena, for a victory. */
  const petals = $('[data-petals]');
  const rain = () => {
    if (reduced) return;
    petals.replaceChildren();
    for (let i = 0; i < 46; i++) {
      const p = document.createElement('i');
      p.style.setProperty('--x', `${Math.random() * 100}%`);
      p.style.setProperty('--d', `${Math.random() * 2.2}s`);
      p.style.setProperty('--t', `${3.2 + Math.random() * 2.4}s`);
      p.style.setProperty('--s', `${0.6 + Math.random() * 0.8}`);
      p.style.setProperty('--r', `${Math.random() * 720 - 360}deg`);
      p.style.setProperty('--sway', `${Math.random() * 60 - 30}px`);
      petals.append(p);
    }
    setTimeout(() => petals.replaceChildren(), 8000);
  };

  const tally = () => {
    if (!current) return;
    $('[data-time]').textContent = clock(current.t);
    const men = (side: string) => current!.cohorts.filter((c) => c.side === side && c.state !== 'gone' && c.state !== 'rout').reduce((n, c) => n + c.men, 0);
    $('[data-roma]').textContent = String(men('roma'));
    $('[data-gallia]').textContent = String(men('gallia'));
    if (!current.result) requestAnimationFrame(tally);
  };

  // The one button: Pugnate! to begin; then the horn, once.
  const setGo = (mode: 'fight' | 'horn' | 'spent') => {
    go.dataset.mode = mode;
    const label = mode === 'fight' ? 'Pugnate!' : t('ludus.charge');
    $('[data-go-icon]').innerHTML = mode === 'fight' ? ICONS.fight : ICONS.horn;
    $('[data-go-label]').textContent = mode === 'fight' ? 'Pugnate!' : 'Signum!';
    go.setAttribute('aria-label', label);
    go.title = label;
    go.disabled = mode === 'spent';
  };
  const fight = () => {
    if (!ludus || count(plan) === 0) return;
    petals.replaceChildren();
    selected = null;
    annales.replaceChildren();
    verdict.hidden = true;
    go.hidden = false;
    tray.hidden = true;
    $('[data-purse]').hidden = true;
    $('[data-tally]').hidden = false;
    current = ludus.fight(plan);
    setGo('horn');
    refresh();
    tally();
  };
  const replan = () => {
    current = null;
    ludus?.reset();
    verdict.hidden = true;
    go.hidden = false;
    tray.hidden = false;
    $('[data-purse]').hidden = false;
    $('[data-tally]').hidden = true;
    setGo('fight');
    refresh();
  };
  go.addEventListener('click', () => {
    if (go.dataset.mode === 'horn') {
      if (ludus?.sound('signum')) setGo('spent');
    } else fight();
  });
  $('[data-again]').addEventListener('click', fight);
  $('[data-replan]').addEventListener('click', replan);

  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-preset]')) {
    b.addEventListener('click', () => {
      if (current) replan();
      plan = preset(b.dataset.preset as Parameters<typeof preset>[0]);
      selected = null;
      refresh();
    });
  }
  $('[data-clear]').addEventListener('click', () => {
    if (current) replan();
    plan = SLOTS.map(() => null);
    selected = null;
    refresh();
  });
  $('[data-share]').addEventListener('click', async () => {
    const url = new URL(location.href);
    url.hash = `plan=${encode(plan)}`;
    history.replaceState(null, '', url);
    try {
      await navigator.clipboard.writeText(url.href);
    } catch {}
    say(t('ludus.shared'));
  });

  // The banderole letters with the page font, so wait for it.
  await document.fonts.load('150px "IM Fell English SC"').catch(() => undefined);
  ludus = createLudus(canvas, {
    name: 'Amphitheatrum',
    reducedMotion: reduced,
    onContextLost: () => document.documentElement.classList.add('no-webgl'),
    onPick: pick,
    onEvent,
    onMarkers,
  });
  if (!ludus) document.documentElement.classList.add('no-webgl');
  ludus?.intro(bookOpened());
  setGo('fight');
  refresh();
  frame.classList.add('is-ready');

  window.addEventListener('pagehide', (e) => !e.persisted && ludus?.dispose());
</script>

