---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Tag from '../components/Tag.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, tags } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body class="bg-void text-parchment">
    <Header />

    <main class="relative z-10 pt-28 pb-24 px-8 md:px-14">
      <article class="max-w-2xl mx-auto">

        <!-- Meta -->
        <div class="flex items-center gap-4 mb-8">
          <a
            href="/blog"
            class="font-mono text-xs text-brush hover:text-signal tracking-widest uppercase transition-colors duration-200"
          >
            ← FIELD NOTES
          </a>
        </div>

        <!-- Header -->
        <header class="mb-12">
          <div class="flex items-center gap-3 mb-6">
            <span class="w-6 h-px bg-signal"></span>
            <time class="font-mono text-xs text-brush tracking-wide">
              <FormattedDate date={pubDate} />
            </time>
            {updatedDate && (
              <span class="font-mono text-xs text-brush tracking-wide">
                · updated <FormattedDate date={updatedDate} />
              </span>
            )}
          </div>

          <h1 class="font-display text-5xl md:text-7xl text-parchment tracking-wide leading-none">
            {title}
          </h1>

          <div class="w-20 h-px bg-signal mt-8"></div>

          {tags && tags.length > 0 && (
            <div class="flex gap-2 flex-wrap mt-6">
              {tags.map((tag) => (
                <Tag tag={tag} href={`/blog/tag/${tag}`} />
              ))}
            </div>
          )}
        </header>

        <!-- Content -->
        <div class="prose">
          <slot />
        </div>

        <!-- Post footer -->
        <div class="mt-16 pt-8 border-t border-trench flex items-center justify-between">
          <a
            href="/blog"
            class="font-mono text-xs text-brush hover:text-signal tracking-widest uppercase transition-colors duration-200"
          >
            ← All entries
          </a>
          <span class="font-mono text-xs text-brush tracking-widest">
            EB
          </span>
        </div>
      </article>
    </main>

    <Footer />
  </body>
</html>
