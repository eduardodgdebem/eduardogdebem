---
// A field note as a chapter of the codex: the opener on the left page, the
// text on the right.
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import Codex from './Codex.astro';
import Plate from '../components/Plate.astro';
import { plateForTags } from '../scripts/codex/catalogue';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & {
  chapter: number;
  headings: MarkdownHeading[];
  prev?: { href: string; title: string };
  next?: { href: string; title: string };
};

const { title, description, pubDate, updatedDate, tags, heroImage, chapter, headings, prev, next } = Astro.props;

const roman = (n: number) =>
  ([['M', 1000], ['CM', 900], ['D', 500], ['CD', 400], ['C', 100], ['XC', 90], ['L', 50], ['XL', 40], ['X', 10], ['IX', 9], ['V', 5], ['IV', 4], ['I', 1]] as const).reduce(
    (acc, [s, v]) => {
      while (acc.n >= v) {
        acc.out += s;
        acc.n -= v;
      }
      return acc;
    },
    { n, out: '' },
  ).out;

const date = (d: Date) => `${d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long' })}, ${roman(d.getFullYear())}`;
// Descriptions still holding the starter's placeholder aren't worth printing.
const lede = description && !/^lorem ipsum/i.test(description) ? description : null;
---

<Codex title={`${title} — ${SITE_TITLE}`} description={description} image={heroImage} folio={10 + chapter * 2}
  prev={prev ? { href: prev.href, label: prev.title } : { href: '/blog', label: 'Commentarii' }}
  next={next && { href: next.href, label: next.title }}
>
  <Fragment slot="verso">
    <a href="/blog" class="back">← Commentarii</a>
    <Plate plate={plateForTags(tags)} banner={`Caput ${roman(chapter)}`} />
    <header class="opener">
      <h1>{title}</h1>
      <p class="date">
        <time datetime={pubDate.toISOString()}>{date(pubDate)}</time>
        {updatedDate && <span class="updated">, revised <time datetime={updatedDate.toISOString()}>{date(updatedDate)}</time></span>}
        {tags && tags.length > 0 && <span class="tags">{tags.map((t) => <a href={`/blog/tag/${t}/`} class="subject">{t}</a>)}</span>}
      </p>
      {lede && <p class="lede">{lede}</p>}
    </header>

    <nav class="turn" aria-label="Other chapters">
      {prev ? <a href={prev.href} rel="prev">← {prev.title}</a> : <span></span>}
      {next && <a href={next.href} rel="next">{next.title} →</a>}
    </nav>
  </Fragment>

  <Fragment slot="recto">
    {headings.length > 1 && (
      <nav class="in-chapter" aria-label="In this chapter">
        <span class="rubric">In hoc capite:</span>
        {headings.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
      </nav>
    )}
    <article class="codex-prose">
      <slot />
    </article>
    <p class="fleuron explicit" aria-hidden="true">❦ Explicit ❦</p>
  </Fragment>
</Codex>

<style>
  .back {
    font-style: italic;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .opener {
    text-align: center;
    margin-top: 0.4rem;
  }

  h1 {
    font-size: clamp(1.6rem, 2.4vw, 2.5rem);
    line-height: 1.08;
    margin: 0 auto;
    max-width: 24ch;
    text-wrap: balance;
  }

  .date {
    font-style: italic;
    color: var(--ink-soft);
    margin: 0.35rem 0 0;
  }

  .tags {
    display: inline-flex;
    gap: 0.6rem;
    margin-left: 0.8rem;
    font-style: normal;
  }

  .lede {
    font-style: italic;
    max-width: 44ch;
    margin: 0.4rem auto 0;
  }

  .turn {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.6rem;
    font-style: italic;
    font-size: 0.92rem;
  }

  .turn a {
    color: var(--ink-soft);
    text-decoration: none;
    max-width: 48%;
  }

  .turn a[rel='next'] {
    text-align: right;
  }

  .in-chapter {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 1rem;
    font-size: 0.92rem;
    font-style: italic;
    padding-bottom: 0.8rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .in-chapter .rubric {
    font-style: normal;
    margin: 0;
  }

  .in-chapter a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .explicit {
    font-family: 'IM Fell English SC', serif;
    letter-spacing: 0.2em;
    margin: 1.5rem 0 0.5rem;
  }
</style>
