---
// Every page is a two-page spread of the codex: <slot name="verso" /> on the
// left, <slot name="recto" /> on the right. Navigating between pages turns
// the leaf (see the page-turn rules in src/styles/codex.css).
import '../styles/codex.css';
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Logo from '../components/Logo.astro';
import Binding from '../components/Binding.astro';
import Corner from '../components/Corner.astro';
import { STRINGS } from '../i18n/strings';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  /** Folio of the left page; the right page is the next one. */
  folio: number;
  /** Keep the page out of search results. */
  noindex?: boolean;
  /** Structured data (JSON-LD). */
  schema?: Record<string, unknown>;
  /** False for a page with no address of its own (the not-found page). */
  canonical?: boolean;
  /** Fit the spread to one screen, without scrolling (the home page; on portrait it scrolls like the rest). */
  fit?: boolean;
}

const { title, description, image, folio, fit = false, noindex = false, schema, canonical = true } = Astro.props;

const roman = (n: number) =>
  ([['M', 1000], ['CM', 900], ['D', 500], ['CD', 400], ['C', 100], ['XC', 90], ['L', 50], ['XL', 40], ['X', 10], ['IX', 9], ['V', 5], ['IV', 4], ['I', 1]] as const).reduce(
    (acc, [s, v]) => {
      while (acc.n >= v) {
        acc.out += s;
        acc.n -= v;
      }
      return acc;
    },
    { n, out: '' },
  ).out.toLowerCase();

const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Index', current: path === '/' },
  { href: '/blog/', label: 'Commentarii', current: path.startsWith('/blog') },
  { href: '/about/', label: 'De auctore', current: path.startsWith('/about') },
];
---

<!doctype html>
<html lang="en" data-folio={folio}>
  <head>
    <BaseHead title={title} description={description} image={image} noindex={noindex} schema={schema} canonical={canonical} />
    <script is:inline>
      // The first page of a visit arrives as a closed book (Binding.astro).
      // Set before first paint so the closed board is what paints; if the
      // opening script never runs, the book opens itself.
      try {
        if (!sessionStorage.getItem('codex-opened') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          sessionStorage.setItem('codex-opened', '1');
          document.documentElement.classList.add('opening');
          setTimeout(() => window.__codexOpening || document.documentElement.classList.remove('opening'), 5000);
        }
      } catch {}
    </script>
    <script is:inline>
      // Tell the page turn which way to go: back through history, or to a
      // lower folio, turns the leaf backward. The page being left records its
      // folio on the way out.
      window.addEventListener('pageswap', (e) => {
        if (!e.viewTransition) return;
        try {
          sessionStorage.setItem('codex-from-folio', document.documentElement.dataset.folio);
        } catch {}
      });
      window.addEventListener('pagereveal', (e) => {
        const vt = e.viewTransition;
        const act = window.navigation && navigation.activation;
        if (!vt || !act || !act.from) return;
        let from = NaN;
        try {
          from = Number(sessionStorage.getItem('codex-from-folio'));
        } catch {}
        const depth = (u) => new URL(u).pathname.split('/').filter(Boolean).length;
        let back = from ? Number(document.documentElement.dataset.folio) < from : depth(act.entry.url) < depth(act.from.url);
        if (act.navigationType === 'traverse') back = act.entry.index < act.from.index;
        vt.types.add(back ? 'back' : 'forward');
      });
    </script>
  </head>
  <body class="codex">
    <div class:list={['book', { 'book--fit': fit }]}>
      <Binding />
      <section class="page verso">
        <header class="running">
          <a href="/" class="mark" aria-label="Codex Eduardi, home"><Logo size={22} /></a>
          <a href="/" class="mark-text">Codex Eduardi</a>
        </header>
        <div class="page-body">
          <slot name="verso" />
        </div>
        <footer class="folio">
          <span>{roman(folio)}</span>
        </footer>
        <Corner dir="back" />
        {/* On portrait the spread is one column: the top of the screen is this page's. */}
        <Corner dir="forward" portrait />
      </section>

      <main class="page recto">
        <header class="running">
          <nav class="running-nav" aria-label="Sections">
            {nav.map((n) => (
              <a href={n.href} aria-current={n.current ? 'page' : undefined}>{n.label}</a>
            ))}
          </nav>
          <div class="lang" role="group" aria-label="Language" data-i18n-label="lang.toggle">
            <button type="button" data-lang="en" lang="en" aria-pressed="true">EN</button>
            <button type="button" data-lang="pt" lang="pt-BR" aria-pressed="false">PT</button>
          </div>
        </header>
        <div class="page-body">
          <slot name="recto" />
        </div>
        <footer class="folio">
          <a href="/rss.xml">rss</a>
          <span>{roman(folio + 1)}</span>
        </footer>
        <Corner dir="forward" />
      </main>
    </div>
    <script is:inline define:vars={{ STRINGS }}>
      // The book in English or Portuguese. Elements carry data-i18n (text) or
      // data-i18n-html (markup) with a key into STRINGS; switching rewrites
      // them in place, inked in letter by letter as if being written. Inline
      // and at the end of the body, so a stored choice applies before first
      // paint. Scripts read it through src/scripts/codex/lang.ts.
      (() => {
        const KEY = 'codex-lang';
        const root = document.documentElement;
        let lang = 'en';
        try {
          lang = localStorage.getItem(KEY) || ((navigator.language || '').toLowerCase().startsWith('pt') ? 'pt' : 'en');
        } catch {}
        if (!STRINGS[lang]) lang = 'en';
        const t = (key) => STRINGS[lang][key] ?? STRINGS.en[key] ?? key;
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

        const content = (el) => (el.dataset.i18nHtml ? t(el.dataset.i18nHtml) : t(el.dataset.i18n));
        const set = (el, value) => {
          if (el.dataset.i18nHtml) el.innerHTML = value;
          else el.textContent = value;
        };
        // An element's text cut into pieces, each in its own span, to be inked a
        // moment after the last: letters for a short line, words for a long
        // paragraph (thousands of animated letters would stutter).
        const pieces = (el, start, step, byWord) => {
          const walk = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
          const nodes = [];
          while (walk.nextNode()) nodes.push(walk.currentNode);
          let i = 0;
          for (const node of nodes) {
            const frag = document.createDocumentFragment();
            for (const piece of node.textContent.split(byWord ? /(\s+)/ : /(\s)/)) {
              if (!piece) continue;
              if (/^\s+$/.test(piece)) {
                frag.append(piece);
                continue;
              }
              for (const unit of byWord ? [piece] : [...piece]) {
                const span = document.createElement('span');
                // The first word stays inline, so a drop cap (::first-letter) still finds it.
                span.className = byWord && i > 0 ? 'quill quill-word' : 'quill';
                span.style.setProperty('--d', `${Math.round(start + i * step)}ms`);
                span.textContent = unit;
                frag.append(span);
                i++;
              }
            }
            node.replaceWith(frag);
          }
        };
        // On screen, and not scrolled out of its page: only that is worth animating.
        const seen = (el) => {
          const r = el.getBoundingClientRect();
          if (!r.width && !r.height) return false;
          const page = el.closest('.page-body')?.getBoundingClientRect();
          const top = Math.max(0, page ? page.top : 0);
          const bottom = Math.min(innerHeight, page ? page.bottom : innerHeight);
          return r.bottom > top && r.top < bottom;
        };

        const apply = (animate) => {
          root.lang = lang === 'pt' ? 'pt-BR' : 'en';
          for (const b of document.querySelectorAll('[data-lang]')) b.setAttribute('aria-pressed', String(b.dataset.lang === lang));
          for (const el of document.querySelectorAll('[data-i18n-label]')) el.setAttribute('aria-label', t(el.dataset.i18nLabel));
          const els = [...document.querySelectorAll('[data-i18n], [data-i18n-html]')];
          let order = 0;
          for (const el of els) {
            const value = content(el);
            if (!animate || reduced || !seen(el)) {
              set(el, value);
              continue;
            }
            // The old words lift off, then the new are written in, top of the page first.
            const start = Math.min(order++ * 55, 900);
            const text = value.replace(/<[^>]*>/g, '');
            const byWord = text.length > 120;
            const count = Math.max(1, byWord ? text.split(/\s+/).length : text.length);
            const step = Math.min(byWord ? 45 : 14, 700 / count);
            el.classList.add('quill-out');
            setTimeout(() => {
              set(el, value);
              pieces(el, start, step, byWord);
              el.classList.remove('quill-out');
              // Back to plain text once dry, so selection and wrapping are as before.
              setTimeout(() => set(el, value), start + count * step + 400);
            }, 180);
          }
        };

        window.codexLang = {
          get lang() {
            return lang;
          },
          t,
        };
        if (lang !== 'en') apply(false);

        document.addEventListener('click', (e) => {
          const b = e.target.closest('[data-lang]');
          if (!b || b.dataset.lang === lang) return;
          lang = b.dataset.lang;
          try {
            localStorage.setItem(KEY, lang);
          } catch {}
          apply(true);
          document.dispatchEvent(new CustomEvent('codex:lang', { detail: lang }));
        });
      })();
    </script>
    <script>
      import { openBook } from '../scripts/codex/opening';
      import { foldCorners } from '../scripts/codex/corners';
      openBook();
      foldCorners();
    </script>
  </body>
</html>
