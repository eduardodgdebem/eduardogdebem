---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import Tag from '../../../components/Tag.astro';
import { SITE_TITLE } from '../../../consts';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const tags = [...new Set(allPosts.flatMap((post) => post.data.tags ?? []))];

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: allPosts
        .filter((post) => post.data.tags?.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
      allTags: tags.sort(),
    },
  }));
}

const { tag, posts, allTags } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${tag} — ${SITE_TITLE}`}
      description={`Posts tagged with "${tag}"`}
    />
  </head>
  <body class="bg-void text-parchment">
    <Header />

    <main class="relative z-10 min-h-screen pt-28 pb-20 px-8 md:px-14">
      <div class="max-w-4xl mx-auto">

        <!-- Page header -->
        <div class="flex items-center gap-4 mb-4">
          <span class="w-6 h-px bg-signal"></span>
          <span class="font-mono text-xs text-brush tracking-[0.2em] uppercase">Field Notes</span>
        </div>
        <h1 class="font-display text-6xl md:text-8xl text-parchment tracking-wide leading-none mb-10">
          FIELD NOTES
        </h1>

        <!-- Tag filter row -->
        <div class="flex items-center gap-2 flex-wrap mb-12 pb-6 border-b border-trench">
          <a
            href="/blog"
            class="font-mono text-[10px] tracking-[0.15em] uppercase px-2 py-0.5 border border-trench text-brush hover:border-signal hover:text-signal transition-colors duration-200"
          >
            ALL
          </a>
          {allTags.map((t) => (
            <Tag tag={t} href={`/blog/tag/${t}`} active={t === tag} />
          ))}
        </div>

        <!-- Filtered post list -->
        <div class="space-y-0">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id}/`}
              class="group flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-8 py-6 border-b border-trench hover:border-signal transition-colors duration-200"
            >
              <time class="font-mono text-xs text-brush tracking-wide shrink-0 w-28">
                <FormattedDate date={post.data.pubDate} />
              </time>
              <div class="flex-1 min-w-0">
                <h2 class="font-display text-2xl text-parchment group-hover:text-signal transition-colors duration-200 leading-tight">
                  {post.data.title}
                </h2>
                {post.data.description && (
                  <p class="text-brush text-sm mt-1 leading-relaxed line-clamp-2">
                    {post.data.description}
                  </p>
                )}
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="flex gap-2 mt-2 flex-wrap">
                    {post.data.tags.map((t) => (
                      <Tag tag={t} />
                    ))}
                  </div>
                )}
              </div>
              <span class="font-mono text-xs text-trench group-hover:text-signal transition-colors duration-200 shrink-0 self-center hidden sm:block">
                →
              </span>
            </a>
          ))}
        </div>

        {posts.length === 0 && (
          <p class="font-mono text-xs text-brush tracking-widest text-center py-20 uppercase">
            No entries for this topic yet.
          </p>
        )}
      </div>
    </main>

    <Footer />
  </body>
</html>
