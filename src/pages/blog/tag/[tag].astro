---
import Commentarii from '../../../components/Commentarii.astro';
import { notes } from '../../../lib/notes';

export async function getStaticPaths() {
  const { posts, chapters, allTags } = await notes();
  return allTags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags?.includes(tag)), chapters, allTags },
  }));
}

const { tag, posts, chapters, allTags } = Astro.props;
---

<Commentarii posts={posts} chapters={chapters} allTags={allTags} activeTag={tag} />
