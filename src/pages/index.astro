---
import { getCollection } from 'astro:content';
import Codex from '../layouts/Codex.astro';
import { CATALOGUE } from '../scripts/codex/catalogue';
import { PLATES } from '../scripts/codex/models';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const roman = (n: number) =>
  ([['M', 1000], ['CM', 900], ['D', 500], ['CD', 400], ['C', 100], ['XC', 90], ['L', 50], ['XL', 40], ['X', 10], ['IX', 9], ['V', 5], ['IV', 4], ['I', 1]] as const).reduce(
    (acc, [s, v]) => {
      while (acc.n >= v) {
        acc.out += s;
        acc.n -= v;
      }
      return acc;
    },
    { n, out: '' },
  ).out;

const plates = PLATES.map((id) => CATALOGUE[id]);
---

<Codex title={SITE_TITLE} description={SITE_DESCRIPTION} folio={1} fit>
  <!-- Verso: the engraved plate, with the name lettered on its banderole -->
  <Fragment slot="verso">
    <figure class="plate">
      <div class="plate-frame">
        <canvas id="engraving" class="plate-canvas" aria-hidden="true"></canvas>
        <div class="plate-fallback" aria-hidden="true"><span>Eduardo de Bem</span></div>
      </div>
      <figcaption class="plate-caption" data-plates={JSON.stringify(plates)}>
        <span class="tab">Tab. <span data-cap-numeral>{plates[0].numeral}</span></span>
        <span class="cap-latin" data-cap-latin>{plates[0].latin}</span>
        <span class="cap-note" data-cap-note>{plates[0].note}</span>
      </figcaption>
    </figure>

    <div class="plate-nav" role="group" aria-label="Choose a plate">
      {plates.map((p, i) => (
        <button type="button" data-plate={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Plate ${p.numeral}: ${p.latin}`}>
          {p.numeral}
        </button>
      ))}
      <span class="hint">move the lamp with your cursor · drag to turn</span>
    </div>
  </Fragment>

  <!-- Recto: of the author, the index, and what he is listening to -->
  <Fragment slot="recto">
    <div class="bio">
      <h1 class="sr-only">Eduardo de Bem</h1>
      <p class="lede">
        <span class="initial">F</span>ullstack developer in Florianópolis. By day, Angular micro frontends with .NET
        and MuleSoft behind them, for a BMW USA financial platform at Zallpy; on the side, React, NestJS, PostgreSQL
        and RabbitMQ.
      </p>
      <p class="more">
        Before that, geoprocessing at eTopocart, where ten-thousand-row tables taught me that performance problems are
        more interesting than they look. Years of violin, now only listened to. Computer Science at UNISUL, graduating
        {roman(2026)}.
      </p>
    </div>

    <nav class="contents" aria-label="Contents">
      <p class="rubric">Index</p>
      <ol>
        <li class="chapter">
          <a href="/blog"><span class="num">I.</span><span class="label">Field notes</span><span class="leader"></span><span class="pg">all</span></a>
          <ol class="sub">
            {posts.map((p) => (
              <li>
                <a href={`/blog/${p.id}/`}><span class="label">{p.data.title}</span><span class="leader"></span><span class="pg">{roman(p.data.pubDate.getFullYear())}</span></a>
              </li>
            ))}
          </ol>
        </li>
        <li class="chapter">
          <a href="/about"><span class="num">II.</span><span class="label">Of the author, at length</span><span class="leader"></span><span class="pg">about</span></a>
        </li>
        <li class="chapter">
          <a href="https://github.com/eduardodgdebem" target="_blank" rel="noopener noreferrer"><span class="num">III.</span><span class="label">Workshop</span><span class="leader"></span><span class="pg">github</span></a>
        </li>
      </ol>
    </nav>

    <!-- Jellyfin: the cover, re-drawn as an engraving; hidden if it can't be reached. -->
    <aside class="listening" data-media hidden aria-label="What I'm listening to and watching">
      <figure class="cover" data-cover hidden>
        <canvas id="cover" aria-hidden="true"></canvas>
      </figure>
      <div class="listening-text">
        <p data-slot="listening" hidden>
          <span class="hand" aria-hidden="true">☞</span> <em data-verb></em><br />
          <span class="track" data-title></span><br /><span class="by" data-sub></span>
        </p>
        <p class="watching" data-slot="watching" hidden>
          <em data-verb></em> <span data-title></span><span class="by" data-sub></span>
        </p>
      </div>
    </aside>
  </Fragment>
</Codex>

<script>
  import { gsap } from 'gsap';
  import { createCoverEngraving } from '../scripts/codex/cover';
  import { createEngraving } from '../scripts/codex/engraving';

  const root = document.documentElement;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canvas = document.getElementById('engraving') as HTMLCanvasElement;

  // The banderole letters with the page font, so wait for it.
  await document.fonts.load('150px "IM Fell English SC"').catch(() => undefined);
  const plate = createEngraving(canvas, {
    name: 'Eduardo de Bem',
    reducedMotion: reduced,
    onContextLost: () => root.classList.add('no-webgl'),
  });
  if (!plate) root.classList.add('no-webgl');
  plate?.intro();

  /* ── Plates ── */

  const caption = document.querySelector<HTMLElement>('.plate-caption')!;
  const plates: { numeral: string; latin: string; note: string }[] = JSON.parse(caption.dataset.plates!);
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-plate]')];
  const cap = {
    numeral: caption.querySelector<HTMLElement>('[data-cap-numeral]')!,
    latin: caption.querySelector<HTMLElement>('[data-cap-latin]')!,
    note: caption.querySelector<HTMLElement>('[data-cap-note]')!,
  };
  let index = 0;
  let auto: gsap.core.Tween | null = null;

  const select = (i: number) => {
    if (i === index) return;
    index = i;
    plate?.show(i);
    buttons.forEach((b, k) => b.setAttribute('aria-pressed', String(k === i)));
    const apply = () => {
      cap.numeral.textContent = plates[i].numeral;
      cap.latin.textContent = plates[i].latin;
      cap.note.textContent = plates[i].note;
    };
    if (reduced) apply();
    else gsap.timeline().to(caption, { autoAlpha: 0, duration: 0.5, onComplete: apply }).to(caption, { autoAlpha: 1, duration: 1.2 }, 1.4);
    schedule();
  };

  const schedule = () => {
    auto?.kill();
    if (!reduced) auto = gsap.delayedCall(11, () => select((index + 1) % plates.length));
  };
  buttons.forEach((b, i) => b.addEventListener('click', () => select(i)));
  canvas.addEventListener('pointerdown', schedule);
  document.addEventListener('visibilitychange', () => (document.hidden ? auto?.pause() : auto?.resume()));
  schedule();

  /* ── Jellyfin: cover engraving and marginal note ── */

  type Entry = { title: string; subtitle: string; image: string | null; live: boolean; paused: boolean } | null;
  const media = document.querySelector<HTMLElement>('[data-media]')!;
  const coverFig = document.querySelector<HTMLElement>('[data-cover]')!;
  const cover = createCoverEngraving(document.getElementById('cover') as HTMLCanvasElement, { reducedMotion: reduced });
  const VERBS = { listening: ['Nunc audit', 'Nuper audivit'], watching: ['Nunc spectat:', 'Nuper spectavit:'] } as const;

  const refresh = async () => {
    try {
      const res = await fetch('/api/now-playing.json');
      if (!res.ok) throw new Error(String(res.status));
      const data = (await res.json()) as Record<'listening' | 'watching', Entry>;
      (['listening', 'watching'] as const).forEach((k) => {
        const el = media.querySelector<HTMLElement>(`[data-slot="${k}"]`)!;
        const e = data[k];
        el.hidden = !e;
        if (!e) return;
        el.querySelector('[data-verb]')!.textContent = VERBS[k][e.live && !e.paused ? 0 : 1];
        el.querySelector('[data-title]')!.textContent = e.title;
        el.querySelector('[data-sub]')!.textContent = k === 'watching' ? (e.subtitle ? `, ${e.subtitle}` : '') : e.subtitle;
      });
      media.hidden = !data.listening && !data.watching;
      // Engrave the record's cover; fall back to the watching poster.
      const art = data.listening?.image ?? data.watching?.image;
      coverFig.hidden = !art || !cover;
      if (art && cover) coverFig.hidden = !(await cover.set(art));
    } catch {
      media.hidden = true;
    }
  };
  refresh();
  setInterval(() => !document.hidden && refresh(), 60_000);

  /* ── Arrival (skipped when arriving by page turn: the leaf is the entrance) ── */

  const turned = !!(window as unknown as { navigation?: { activation?: { from?: unknown } } }).navigation?.activation?.from;
  if (!reduced && !turned) {
    gsap.from('.recto .page-body > *', { autoAlpha: 0, y: 8, duration: 1.4, stagger: 0.12, ease: 'power2.out', delay: 0.6 });
    gsap.from('.plate-caption, .plate-nav', { autoAlpha: 0, duration: 1.4, delay: 2.4 });
  }

  // Kept alive when the page goes into the back/forward cache.
  window.addEventListener('pagehide', (e) => {
    if (e.persisted) return;
    plate?.dispose();
    cover?.dispose();
  });
</script>

<style>
  /* ── Verso ── */

  .plate-nav {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0.5rem 12px 0;
  }

  .plate-nav button {
    font-family: 'IM Fell English SC', serif;
    font-size: 1rem;
    min-width: 2.4rem;
    padding: 0.2rem 0.6rem;
    background: none;
    border: 1px solid transparent;
    color: var(--ink-soft);
    cursor: pointer;
  }

  .plate-nav button:hover {
    color: var(--ink);
    border-color: var(--rule);
  }

  .plate-nav button[aria-pressed='true'] {
    color: var(--rubric);
    border-color: var(--rubric);
  }

  .hint {
    margin-left: auto;
    font-style: italic;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  /* ── Recto ── */

  .bio {
    margin-top: clamp(4px, 1.6vh, 20px);
  }

  .lede,
  .more {
    font-size: clamp(1.02rem, 0.55vw + 0.62rem, 1.22rem);
    line-height: 1.5;
    max-width: 54ch;
    margin: 0 0 0.6rem;
    hyphens: auto;
    text-align: justify;
  }

  .more {
    color: var(--ink-soft);
  }

  .contents {
    margin-top: clamp(10px, 2vh, 24px);
  }

  .chapter > a {
    font-size: 1.1rem;
  }

  .sub {
    padding-left: 3.1ch !important;
    margin-bottom: 0.3rem !important;
  }

  .sub a {
    font-style: italic;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  /* ── Listening: the engraved cover beside its note ── */

  .listening {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-top: auto;
    padding-top: 12px;
  }

  .listening[hidden],
  .listening [hidden] {
    display: none;
  }

  .cover {
    flex: none;
    width: clamp(84px, 13vh, 140px);
    aspect-ratio: 1;
    margin: 6px;
    border: 1px solid var(--ink);
    outline: 1px solid var(--ink);
    outline-offset: 3px;
  }

  #cover {
    display: block;
    width: 100%;
    height: 100%;
  }

  .listening-text p {
    margin: 0;
    line-height: 1.3;
  }

  .listening em,
  .hand {
    color: var(--rubric);
  }

  .track {
    font-size: 1.25rem;
  }

  .by {
    font-style: italic;
    color: var(--ink-soft);
  }

  .watching {
    margin-top: 0.5rem !important;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  /* ── Shorter screens: shed the secondary lines first ── */

  @media (max-height: 760px) and (min-aspect-ratio: 1/1) {
    .more {
      display: none;
    }
  }

  @media (max-height: 680px) and (min-aspect-ratio: 1/1) {
    .sub li:nth-child(n + 2),
    .watching {
      display: none;
    }
  }

  /* ── Portrait: plate above, author below, still one screen ── */

  @media (max-aspect-ratio: 1/1) {
    :global(.book--fit .running),
    :global(.book--fit .verso .folio),
    .hint,
    .cap-note,
    .more,
    .sub,
    .watching,
    .contents .rubric {
      display: none;
    }

    .lede {
      font-size: 0.95rem;
      line-height: 1.4;
      margin: 0;
    }

    .chapter > a {
      font-size: 1rem;
    }

    .contents {
      margin-top: 8px;
    }

    .cover {
      width: 64px;
    }

    .track {
      font-size: 1.05rem;
    }
  }
</style>
