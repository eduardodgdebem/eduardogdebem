---
// Any address the site doesn't have: a statue, and the way back.
import Shell from '../layouts/Shell.astro';
import Art from '../components/Art.astro';
import { UI } from '../data/site';

export const prerender = true;
---

<Shell title="Not found — Eduardo de Bem" description={UI.notFoundText.en} lang="en" noindex canonical={false}>
  <main class="lost">
    <div class="lost-text">
      <p class="lost-num">CDIV</p>
      <h1 class="lost-title">{UI.notFound.en}</h1>
      <p class="lede">{UI.notFoundText.en}</p>
      <p class="actions"><a class="button button--accent" href="/">{UI.back.en}</a></p>
    </div>
    <Art id="gladiator-head" class="lost-art" />
  </main>
</Shell>

