---
import Plate from '../components/Plate.astro';
import Codex from '../layouts/Codex.astro';
import { SITE_TITLE } from '../consts';

const notes: [string, string[]][] = [
  ['Currently', ['Zallpy — fullstack', 'BMW financial platform', 'React · NestJS · RabbitMQ project']],
  ['Reading', ['Sci-fi', 'Fantasy', 'Whatever catches me']],
  ['Racing', ['Formula 1', 'Constructor standings > driver standings']],
  ['Fighting', ['MMA', 'Boxing', 'Combat sports in general']],
  ['Music', ['Ex-violinist', 'Still listens']],
  ['Tongues', ['Portuguese — native', 'English — advanced', 'Spanish — intermediate']],
];
---

<Codex
  title={`De auctore — ${SITE_TITLE}`}
  description="Fullstack developer based in Florianópolis. Building financial systems, AR platforms, and writing about it."
  folio={7}
>
  <Fragment slot="verso">
    <Plate plate="sigillum" banner="De auctore" />
  </Fragment>

  <Fragment slot="recto">
    <p class="rubric">Liber II · De auctore</p>
    <h1>Eduardo de Bem</h1>

    <div class="codex-prose">
      <p>
        Fullstack developer based in Florianópolis, SC. Currently at Zallpy building a financial platform for BMW USA —
        Angular micro frontends on the front, .NET and MuleSoft behind it, all wired through Amazon API Gateway.
        Alongside that, I've been deep in a separate project for the past six months: React + Vite, NestJS, PostgreSQL,
        and RabbitMQ.
      </p>
      <p>
        Before Zallpy I was at eTopocart working on geoprocessing software — the kind of frontend work that involves
        rendering 10,000-row tables without the browser giving up, and making different browser tabs talk to each
        other. It was a good place to learn that performance problems are usually more interesting than they look.
      </p>
      <p>
        In 2023 I spent a year between the US and Europe. Went to sharpen my English. Came back with that plus a clearer
        idea of what I actually want to build.
      </p>
      <p>
        I used to play violin — seriously, for years. I don't anymore. But the same instincts carry over: you can tell
        when something is slightly off even if you can't name it yet, and the only way to get good at something is to
        show up before you're ready.
      </p>
      <p>
        I'm studying Computer Science at UNISUL (graduating 2026) and volunteer on a WebGL-based augmented reality
        project there — which is how I ended up comfortable enough with 3D rendering to engrave the plates in this book.
      </p>

      <h2>What I work with</h2>
      <p>
        On the frontend: TypeScript, React, Angular, and micro frontend architectures day-to-day. On the backend:
        Node.js, NestJS, and .NET depending on the project. I've worked with PostgreSQL, RabbitMQ, MuleSoft, and AWS (API
        Gateway, Lambda). I pick up what the problem needs — the stack debate is usually less interesting than the
        problem itself.
      </p>
    </div>

    <h2 class="rubric notes-head">Marginalia</h2>
    <dl class="notes">
      {notes.map(([head, items]) => (
        <div>
          <dt>{head}</dt>
          <dd>{items.join(' · ')}</dd>
        </div>
      ))}
    </dl>

    <h2 class="rubric notes-head">Correspondence</h2>
    <p class="contact">
      If you want to talk about a project, a role, or just found something here worth discussing —
      <a href="mailto:eduardogdebem@gmail.com">send me an email</a>, or find me on
      <a href="https://linkedin.com/in/eduardogdebem" target="_blank" rel="noopener noreferrer">LinkedIn</a> and
      <a href="https://github.com/eduardodgdebem" target="_blank" rel="noopener noreferrer">GitHub</a>.
    </p>
    <p class="fleuron" aria-hidden="true">❦</p>
  </Fragment>
</Codex>

<style>
  h1 {
    font-size: clamp(2.4rem, 3.6vw, 3.6rem);
    margin: 0 0 1rem;
  }

  .notes-head {
    font-size: 1rem;
    margin: 1.6rem 0 0.6rem;
  }

  .notes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem 2rem;
    margin: 0;
  }

  .notes dt {
    font-family: 'IM Fell English SC', serif;
    letter-spacing: 0.08em;
    color: var(--ink);
  }

  .notes dd {
    margin: 0;
    font-style: italic;
    color: var(--ink-soft);
  }

  .contact {
    max-width: 62ch;
  }

  .contact a {
    color: var(--rubric);
  }

  @media (max-width: 560px) {
    .notes {
      grid-template-columns: 1fr;
    }
  }
</style>
