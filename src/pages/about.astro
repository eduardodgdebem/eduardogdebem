---
import Plaza, { type PlazaMonument } from '../components/Plaza.astro';
import Codex from '../layouts/Codex.astro';
import { SITE_TITLE } from '../consts';

const EMAIL = 'eduardogdebem@gmail.com';
const LINKEDIN = 'https://linkedin.com/in/eduardogdebem';
const GITHUB = 'https://github.com/eduardodgdebem';

const notes: [string, string[]][] = [
  ['Currently', ['Full stack at Zallpy', 'Data pipelines for BMW Europe', 'Finishing CS at UNISUL']],
  ['Reading', ['Sci-fi', 'Fantasy', 'Whatever catches me']],
  ['Racing', ['Formula 1', 'Constructor standings > driver standings']],
  ['Fighting', ['MMA', 'Boxing', 'Combat sports in general']],
  ['Music', ['Played the violin for years', 'Still listens']],
  ['Tongues', ['Portuguese — native', 'English — advanced', 'Spanish — intermediate']],
];

// Each note stands as a monument in the plaza on the left page.
const MONUMENT: Record<string, Pick<PlazaMonument, 'plate' | 'inscription'>> = {
  Currently: { plate: 'machina', inscription: 'OFFICINA' },
  Reading: { plate: 'liber', inscription: 'LIBRI' },
  Racing: { plate: 'currus', inscription: 'CIRCVS' },
  Fighting: { plate: 'galea', inscription: 'PVGNA' },
  Music: { plate: 'fides', inscription: 'MVSICA' },
  Tongues: { plate: 'stilus', inscription: 'LINGVAE' },
};
const monuments: PlazaMonument[] = notes.map(([head, items]) => ({ ...MONUMENT[head], head, text: items.join(' · ') }));
---

<Codex
  title={`De auctore — ${SITE_TITLE}`}
  description="Full stack developer in Florianópolis, working on data pipelines and front ends, and writing down what I learn."
  folio={3}
>
  <Fragment slot="verso">
    <Plaza monuments={monuments} banner="De auctore" />
  </Fragment>

  <Fragment slot="recto">
    <p class="rubric">Liber II · De auctore</p>
    <h1>Eduardo de Bem</h1>
    <p class="reach">
      <a href={`mailto:${EMAIL}`}>Email</a>
      <a href={LINKEDIN} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={GITHUB} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="#correspondence">All contact details ↓</a>
    </p>

    <div class="codex-prose">
      <p>
        Hi, I'm Eduardo, a full stack developer in Florianópolis. I work at Zallpy, where I started as a front-end intern in 2024
        and I'm now a mid-level developer. These days I'm on a BMW Europe project, writing the back-end pipelines that
        pull data in, transform it and run the background jobs around it, in Node.js, PostgreSQL and BullMQ.
      </p>
      <p>
        Before that I was on BMW USA's financial platform, building the Angular front end as micro frontends on top
        of .NET and MuleSoft services. The part I'm proudest of is the load time: it went from over ten seconds to
        under one. I also built Dema, a platform in React, NestJS, RabbitMQ and PostgreSQL that shows people in
        Brazil the social programs they can get, and suggests careers from a personality test and what's on offer in
        their city.
      </p>
      <p>
        My first job as a developer was at eTopocart in Criciúma, on a geoprocessing platform that city halls around
        Brazil use. It was mostly maps and a lot of data: I made the map views render faster, built tables that hold
        more than ten thousand rows without choking, and moved report generation onto AWS Lambda.
      </p>
      <p>
        In 2023 I took a year off and lived between the US and Europe, mostly to get my English where I wanted it.
        I'm finishing Computer Science at UNISUL this year. Until July I also volunteered on TEKTAI, an augmented
        reality project for students there, which is where I learned enough WebGL to draw the plates in this book.
      </p>
      <p>I played the violin for years. I don't anymore, but I still listen to a lot of music.</p>

      <h2>What I work with</h2>
      <p>
        Mostly TypeScript: Angular or React on the front, Node.js, NestJS or .NET on the back. PostgreSQL and SQL
        Server for data, RabbitMQ and BullMQ for queues, AWS Lambda and API Gateway when it runs in the cloud. I'm
        happy to learn whatever else a project needs.
      </p>
    </div>

    <h2 class="rubric notes-head">Marginalia</h2>
    <dl class="notes">
      {notes.map(([head, items], i) => (
        <div data-monument={i}>
          <dt>{head}</dt>
          <dd>{items.join(' · ')}</dd>
        </div>
      ))}
    </dl>

    <section class="correspondence" id="correspondence" aria-labelledby="correspondence-head">
      <h2 class="rubric notes-head" id="correspondence-head">Correspondence</h2>
      <p class="contact">
        For a role, a project, or a question about something I wrote, email is the quickest way to reach me.
      </p>
      <dl class="letters">
        <div>
          <dt>Email</dt>
          <dd>
            <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
            <button type="button" class="copy" data-copy={EMAIL}>Copy</button>
          </dd>
        </div>
        <div>
          <dt>LinkedIn</dt>
          <dd><a href={LINKEDIN} target="_blank" rel="noopener noreferrer">linkedin.com/in/eduardogdebem</a></dd>
        </div>
        <div>
          <dt>GitHub</dt>
          <dd><a href={GITHUB} target="_blank" rel="noopener noreferrer">github.com/eduardodgdebem</a></dd>
        </div>
        <div>
          <dt>Based in</dt>
          <dd>Florianópolis, Brazil · UTC−3</dd>
        </div>
        <div>
          <dt>Speaks</dt>
          <dd>Portuguese, English, Spanish</dd>
        </div>
      </dl>
      <p class="write">
        <a class="write-button" href={`mailto:${EMAIL}?subject=${encodeURIComponent('Hello Eduardo')}`}>Write to me</a>
      </p>
    </section>
    <p class="fleuron" aria-hidden="true">❦</p>
  </Fragment>
</Codex>

<script>
  // Copy the address, for readers whose mailto links go nowhere.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy!);
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Press ⌘C';
        getSelection()?.selectAllChildren(button.previousElementSibling!);
      }
      setTimeout(() => (button.textContent = 'Copy'), 2000);
    });
  }
</script>

<style>
  h1 {
    font-size: clamp(2.4rem, 3.6vw, 3.6rem);
    margin: 0 0 1rem;
  }

  .notes-head {
    /* Rubricated, like every section mark (the book's heading colour would otherwise win). */
    color: var(--rubric);
    font-size: 1rem;
    margin: 1.6rem 0 0.6rem;
  }

  .notes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem 2rem;
    margin: 0;
  }

  .notes div.is-lit dt {
    color: var(--rubric);
  }

  .notes dt {
    font-family: 'IM Fell English SC', serif;
    letter-spacing: 0.08em;
    color: var(--ink);
  }

  .notes dd {
    margin: 0;
    font-style: italic;
    color: var(--ink-soft);
  }

  /* Contact at a glance, under the name. */
  .reach {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.1rem;
    margin: -0.4rem 0 1.1rem;
    font-family: 'IM Fell English SC', serif;
    letter-spacing: 0.06em;
  }

  .reach a {
    color: var(--rubric);
    text-decoration: none;
  }

  .reach a:hover {
    text-decoration: underline;
  }

  .contact {
    max-width: 62ch;
  }

  /* The correspondence card: each way in, spelled out. */
  .letters {
    margin: 0.8rem 0 0;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--rule);
    outline: 1px solid var(--rule);
    outline-offset: 3px;
    display: grid;
    gap: 0.45rem;
  }

  .letters div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    align-items: baseline;
    gap: 1rem;
  }

  .letters dt {
    font-family: 'IM Fell English SC', serif;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }

  .letters dd {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
  }

  .letters a {
    color: var(--ink);
  }

  .copy {
    font: inherit;
    font-family: 'IM Fell English SC', serif;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    padding: 0 0.5rem;
    color: var(--ink-soft);
    background: none;
    border: 1px solid var(--rule);
    border-radius: 2px;
    cursor: pointer;
  }

  .copy:hover {
    color: var(--rubric);
    border-color: var(--rubric);
  }

  .write {
    margin: 1rem 0 0;
  }

  .write-button {
    display: inline-block;
    padding: 0.35rem 1.1rem 0.4rem;
    font-family: 'IM Fell English SC', serif;
    letter-spacing: 0.08em;
    color: var(--paper) !important;
    background: var(--rubric);
    text-decoration: none;
    border-radius: 2px;
  }

  .write-button:hover {
    background: #7f2318;
  }

  @media (max-width: 560px) {
    .letters div {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .notes {
      grid-template-columns: 1fr;
    }
  }
</style>
